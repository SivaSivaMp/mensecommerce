<%-include("../partials/user/header")%>
<style>
.price-details-box {
  background: #fff;
  border: 1px solid #e0e0e0;
  border-radius: 8px;
  padding: 20px 24px;
  width: 100%;
  max-width: 340px;
  margin: 0 auto 20px;
  font-family: "Inter", sans-serif;
  box-sizing: border-box;
}

.price-details-box h2 {
  font-size: 16px;
  font-weight: 600;
  margin-bottom: 15px;
  text-transform: uppercase;
  color: #555;
}

.price-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 8px 0;
  font-size: 15px;
  color: #333;
}

.price-row.discount span:last-child {
  color: #2ca02c;
  font-weight: 500;
}

.price-row.total {
  font-size: 17px;
  font-weight: 600;
  color: #000;
}

.divider {
  border: none;
  border-top: 1px dashed #ddd;
  margin: 10px 0;
}

.save-text {
  color: #2ca02c;
  font-size: 14px;
  font-weight: 500;
  text-align: left;
  margin-top: 8px;
  line-height: 1.4;
}

.green {
  font-weight: 600;
}

.tf-page-cart-checkout {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
}

.cart-checkout-btn {
  width: 100%;
  max-width: 340px;
}

.tf-cart-item[data-in-stock="false"] {
  opacity: 0.7;
  background-color: #f5f5f5;
}

.out-of-stock-badge {
  display: inline-block;
  margin-top: 5px;
}
</style>
        <!-- page-title -->
        <div class="tf-page-title style-2">
            <div class="container-full">
                <div class="heading text-center ">Shopping Cart</div>
            </div>
        </div>
        <!-- /page-title -->

<!-- page-cart -->
<section class="flat-spacing-11">
  <div class="container">
    <div class="tf-page-cart-wrap">
      <div class="tf-page-cart-item">
        <% if (cartItems.length > 0) { %>
          <form id="cart-form">
            <table class="tf-table-page-cart">
              <thead>
                <tr>
                  <th>Product</th>
                  <th>Price</th>
                  <th>Quantity</th>
                  <th>Total</th>
                </tr>
              </thead>
              <tbody>
                <% cartItems.forEach((item) => {
                  const isOutOfStock = item.isOutOfStock;
                  const isUnlisted = item.isUnlisted || item.isUnlistedProduct || item.isUnlistedCategory; 
                %>
                  <tr class="tf-cart-item file-delete" 
                      data-product-id="<%= item.productId %>" 
                      data-in-stock="<%= !isOutOfStock %>">
                    
                    <!-- Product Column -->
                    <td class="tf-cart-item_product">
                      <a href="/product-detail/<%= item.productId %>" class="img-box">
                        <img src="<%= item.productImage %>" alt="<%= item.productName %>">
                      </a>
                      <div class="cart-info">
                        <a href="/product-detail/<%= item.productId %>" class="cart-title link"><%= item.productName %></a>
                        <div class="cart-meta-variant">
                          <%= item.size %>
                          <strike>
                            <div class="cart-meta-variant">₹<%= item.originalPrice.toLocaleString('en-IN') %></div>
                          </strike>
                        </div>

                        <% if (isOutOfStock) { %>
                          <span class="out-of-stock-badge" style="color: #d32f2f; font-weight: 500;">Out of Stock</span>
                          <a href="javascript:void(0);" class="remove-cart " data-item-id="<%= item._id %>">Remove</a>
                        <% } else if (isUnlisted) { %>
                          <span class="out-of-stock-badge" style="color: #d32f2f; font-weight: 500;">Product not Available</span>
                          <a href="javascript:void(0);" class="remove-cart " data-item-id="<%= item._id %>">Remove</a>
                        <% } else { %>
                          <a href="javascript:void(0);" class="remove-cart " data-item-id="<%= item._id %>">Remove</a>
                        <% } %>
                      </div>
                    </td>

                    <!-- Price Column -->
                    <td class="tf-cart-item_price" cart-data-title="Price">
                      <div class="cart-price">₹<%= item.salePrice.toLocaleString('en-IN') %></div>
                    </td>

                    <!-- Quantity Column (only show if available & listed) -->
                    <% if (!isOutOfStock && !isUnlisted) { %>
                      <td class="tf-cart-item_quantity" cart-data-title="Quantity">
                        <div class="cart-quantity">
                          <div class="wg-quantity">
                            <span class="btn-quantity minus-btn" data-item-id="<%= item._id %>">
                              <svg class="d-inline-block" width="9" height="1" viewBox="0 0 9 1" fill="currentColor">
                                <path d="M9 1H0V0H9V1Z"></path>
                              </svg>
                            </span>
                            <input type="text" name="quantity" value="<%= item.quantity %>" data-item-id="<%= item._id %>" readonly>
                            <span class="btn-quantity plus-btn" data-item-id="<%= item._id %>">
                              <svg class="d-inline-block" width="9" height="9" viewBox="0 0 9 9" fill="currentColor">
                                <path d="M9 5.14286H5.14286V9H3.85714V5.14286H0V3.85714H3.85714V0H5.14286V3.85714H9V5.14286Z"></path>
                              </svg>
                            </span>
                          </div>
                        </div>
                      </td>
                    <% } else { %>
                      <td class="tf-cart-item_quantity" cart-data-title="Quantity">
                        <div class="cart-quantity" style="color:#d32f2f;font-weight:500;" >
                          N/A
                        </div>
                      </td>
                    <% } %>

                    <!-- Total Column -->
                    <td class="tf-cart-item_total" cart-data-title="Total">
                      <div class="cart-total">₹<%= (item.salePrice * item.quantity).toLocaleString('en-IN') %></div>
                    </td>
                  </tr>
                <% }); %>
        </tbody>
            </table>
          </form>
        <% } else { %>
          <div style="text-align: center; padding: 40px;">
            <p style="font-size: 18px; color: #666;">Your cart is empty</p>
            <a href="/shop" class="tf-btn btn-fill animate-hover-btn radius-3" style="display: inline-block; margin-top: 20px;">
              <span>Continue Shopping</span>
            </a>
          </div>
        <% } %>
      </div>

      <% if (cartItems.length > 0) { %>
        <!-- Price Details Section -->
        <div class="tf-page-cart-footer">
          <div class="tf-cart-footer-inner">
            <div class="tf-page-cart-checkout">
              <div class="price-details-box">
                <h2>PRICE DETAILS</h2>

                <div class="price-row">
                  <span>Price (<%= itemCount %> item<%= itemCount !== 1 ? 's' : '' %>)</span>
                  <span>₹<%= priceDetails.totalPrice.toLocaleString('en-IN') %></span>
                </div>

                <% if (priceDetails.discount > 0) { %>
                  <div class="price-row discount">
                    <span>Discount</span>
                    <span>- ₹<%= priceDetails.discount.toLocaleString('en-IN') %></span>
                  </div>
                <% } %>
                <hr class="divider">

                <div class="price-row total">
                  <strong>Total Amount</strong>
                  <strong>₹<%= priceDetails.totalAmount.toLocaleString('en-IN') %></strong>
                </div>

                <hr class="divider">

                <% if (priceDetails.savings > 0) { %>
                  <div class="save-text">
                    You will save <span class="green">₹<%= priceDetails.savings.toLocaleString('en-IN') %></span> on this order
                  </div>
                <% } %>
              </div>

              <div class="cart-checkout-btn">
                <button type="button" class="tf-btn w-100 btn-fill animate-hover-btn radius-3 justify-content-center checkout-btn">
                  <span>Check out</span>
                </button>
              </div>
            </div>
          </div>
        </div>
        <!-- End of Price Details Section -->
      <% } %>
    </div>
    <ul class="tf-pagination-wrap tf-pagination-list">
  <% if (pagination && pagination.totalPages > 1) { %>

    <!-- Prev Button -->
    <% if (pagination.hasPrev) { %>
      <li>
        <a href="?page=<%= pagination.currentPage - 1 %>" 
           class="pagination-link animate-hover-btn">
          <span class="icon icon-arrow-left"></span>
        </a>
      </li>
    <% } %>

    <!-- Page Numbers -->
    <% for (let i = 1; i <= pagination.totalPages; i++) { %>
      <li class="<%= i === pagination.currentPage ? 'active' : '' %>">
        <a href="?page=<%= i %>" 
           class="pagination-link <%= i !== pagination.currentPage ? 'animate-hover-btn' : '' %>">
          <%= i %>
        </a>
      </li>
    <% } %>

    <!-- Next Button -->
    <% if (pagination.hasNext) { %>
      <li>
        <a href="?page=<%= pagination.currentPage + 1 %>" 
           class="pagination-link animate-hover-btn">
          <span class="icon icon-arrow-right"></span>
        </a>
      </li>
    <% } %>

  <% } %>
</ul>
  </div>
</section>
<!-- page-cart -->

<%-include("../partials/user/footer")%>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const removeButtons = document.querySelectorAll('.remove-cart');

    removeButtons.forEach((button) => {
      button.addEventListener('click', async (e) => {
        const itemId = e.currentTarget.getAttribute('data-item-id');

        const result = await Swal.fire({
          title: 'Remove Item?',
          text: 'Are you sure you want to remove this item from your cart?',
          icon: 'warning',
          showCancelButton: true,
          confirmButtonColor: '#d33',
          cancelButtonColor: '#3085d6',
          confirmButtonText: 'Yes, remove it',
          cancelButtonText: 'Cancel',
        });

        if (!result.isConfirmed) return;

        try {
          const response = await axios.delete(`/cart/remove/${itemId}`);
          console.log('Full response:', response);

          if ( response.data.success) {
          
            await Swal.fire({
              icon: 'success',
              title: 'Removed!',
              text: response.data.message || 'Item removed from cart successfully',
              timer: 1300,
              showConfirmButton: false,
            });
            setTimeout(() => {
              window.location.reload();
            }, 100);

          } else {
            Swal.fire({
              icon: 'error',
              title: 'Error',
              text: response.data.message || 'Failed to remove item. Please try again.',
            });
          }

        } catch (error) {
          console.error('Error removing item:', error);
          const errorMsg =
            error.response?.data?.message || 'Something went wrong while removing the item.';
          Swal.fire({
            icon: 'error',
            title: 'Oops...',
            text: errorMsg,
          });
        }
      });
    });
  });
</script>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const minusButtons = document.querySelectorAll('.minus-btn');
    const plusButtons = document.querySelectorAll('.plus-btn');

    // Helper: update DOM after successful update
    const updateCartUI = (itemId, newQuantity, newTotal) => {
      const quantityInput = document.querySelector(`input[data-item-id="${itemId}"]`);
      const totalElement = document.querySelector(`.tf-cart-item_total [data-item-id="${itemId}"]`) ||
                           quantityInput.closest('tr').querySelector('.cart-total');
      
      if (quantityInput) quantityInput.value = newQuantity;
      if (totalElement) totalElement.textContent = `₹${newTotal.toLocaleString('en-IN')}`;
    };

    // Common function to handle quantity change
    const handleQuantityChange = async (itemId, change) => {
      try {
        const response = await axios.put(`/cart/update/${itemId}`, {
          quantityChange: change
        });

        if (response.data.success) {
          updateCartUI(itemId, response.data.newQuantity, response.data.newTotal);
          Swal.fire({
            icon: 'success',
            title: 'Updated',
            text: response.data.message,
            timer: 800,
            showConfirmButton: false
          });setTimeout(() => {
              window.location.reload();
            }, 100);
        } else {
          Swal.fire({
            icon: 'warning',
            title: 'Notice',
            text: response.data.message
          });
        }
      } catch (error) {
        const msg = error.response?.data?.message || 'Failed to update quantity.';
        Swal.fire({
          icon: 'error',
          title: 'Error',
          text: msg
        });
      }
    };

    // Event listeners for plus and minus buttons
    minusButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const itemId = btn.getAttribute('data-item-id');
        handleQuantityChange(itemId, -1);
      });
    });

    plusButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const itemId = btn.getAttribute('data-item-id');
        handleQuantityChange(itemId, 1);
      });
    });
  });
</script>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const checkoutBtn = document.querySelector('.checkout-btn');

    checkoutBtn.addEventListener('click', async () => {
      const cartRows = document.querySelectorAll('.tf-cart-item');
      let hasInvalid = false;

      // Check if any item is out of stock or unavailable
      cartRows.forEach(row => {
        const isOutOfStock = row.getAttribute('data-in-stock') === 'false';
        const unlistedBadge = row.querySelector('.out-of-stock-badge');
        const isUnlisted = unlistedBadge && unlistedBadge.textContent.includes('not Available');

        if (isOutOfStock || isUnlisted) {
          hasInvalid = true;
        }
      });

      if (hasInvalid) {
        Swal.fire({
          icon: 'warning',
          title: 'Cannot Proceed to Checkout',
          text: 'Some items in your cart are out of stock or no longer available. Please remove them to continue.',
          confirmButtonText: 'OK',
          confirmButtonColor: '#d33'
        });
        return;
      }

      try {
        const response = await axios.get('/cart/validate');
        if (response.data.success) {
          window.location.href = '/checkout';
        }
      } catch (error) {
        const message = error.response?.data?.message || 
                        'Something went wrong while checking your cart. Please try again.';

        Swal.fire({
          icon: 'warning',
          title: 'Cannot Proceed to Checkout',
          text: message,
          confirmButtonText: 'OK',
          confirmButtonColor: '#d33'
        }).then(() => {
          window.location.reload();
        });
      }
    });
  });
</script>







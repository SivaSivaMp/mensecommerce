<%-include("../partials/user/header")%>
<style>
/* ---------------------------
   General Card Styling
---------------------------- */
.profile-card {
  background: #ffffff;
  border-radius: 14px;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
  padding: 35px;
  margin-bottom: 30px;
  transition: all 0.3s ease;
}

.profile-card:hover {
  box-shadow: 0 6px 25px rgba(0, 0, 0, 0.08);
}

/* ---------------------------
   Form Input Styling
---------------------------- */
.form-control {
  padding: 12px 14px;
  border-radius: 10px;
  border: 1px solid #dfe3e8;
  font-size: 15px;
  color: #333;
  background-color: #fafafa;
  transition: all 0.2s ease;
}

.form-control::placeholder {
  color: #adb5bd;
}

.form-control:focus {
  background-color: #fff;
  border-color: #088178;
  box-shadow: 0 0 0 0.2rem rgba(8, 129, 120, 0.15);
  outline: none;
}

/* ---------------------------
   Section Headings
---------------------------- */
.profile-card h6 {
  font-size: 1rem;
  font-weight: 600;
  color: #121313;
  margin-top: 10px;
  margin-bottom: 10px;
  letter-spacing: 0.3px;
}

/* ---------------------------
   Radio Buttons (Home/Work/Other)
---------------------------- */
input[type="radio"] {
  accent-color: #088178;
  margin-right: 6px;
  cursor: pointer;
}

label span {
  font-weight: 500;
  color: #444;
}

label span:hover {
  color: #088178;
}

/* ---------------------------
   Buttons
---------------------------- */
.save-btn {
  background-color: #088178;
  color: white;
  border: none;
  border-radius: 10px;
  padding: 12px 36px;
  font-size: 15px;
  font-weight: 600;
  letter-spacing: 0.5px;
  transition: all 0.3s ease;
}

.save-btn:hover {
  background-color: #066c65;
  transform: translateY(-1px);
}

.save-btn:disabled {
  background-color: #c2d3d0;
  cursor: not-allowed;
}

/* ---------------------------
   Alert Boxes
---------------------------- */
.alert {
  border-radius: 8px;
  font-size: 14px;
  padding: 12px 18px;
}

.alert-danger {
  background: #ffe5e5;
  color: #d32f2f;
  border: 1px solid #ffcdd2;
}

.alert-success {
  background: #e8f5e9;
  color: #2e7d32;
  border: 1px solid #c8e6c9;
}

/* ---------------------------
   Address Form Layout
---------------------------- */
#add-address-form .row {
  row-gap: 18px;
}

#add-address-form input[type="text"],
#add-address-form input[type="tel"] {
  font-weight: 400;
}

/* ---------------------------
   Success Toast
---------------------------- */
#copySuccess {
  position: fixed;
  top: 25px;
  right: 25px;
  padding: 14px 25px;
  background-color: #088178;
  color: white;
  border-radius: 10px;
  display: none;
  z-index: 1000;
  animation: fadeInOut 2s ease-in-out;
}
  .error-message {
            color: #dc3545;
            font-size: 0.875rem;
            margin-top: 0.25rem;
            margin-bottom: 0.5rem;
            display: none;
        }

@keyframes fadeInOut {
  0% { opacity: 0; transform: translateY(-15px); }
  15% { opacity: 1; transform: translateY(0); }
  85% { opacity: 1; transform: translateY(0); }
  100% { opacity: 0; transform: translateY(-15px); }
}
</style>
<div class="tf-breadcrumb">
            <div class="container">
                <div class="tf-breadcrumb-wrap d-flex justify-content-between flex-wrap align-items-center">
                    <div class="tf-breadcrumb-list">
                        <a href="/" class="text">Home</a>
                        <i class="icon icon-arrow-right"></i>
                        <a href="/profile/address" class="text">Address</a>
                        <i class="icon icon-arrow-right"></i>
                        <span class="text">Add Address</span>
                    </div> 
                </div>
            </div>
        </div>

<section class="flat-spacing-11">
  <div class="container">
    <div class="row">
 <div class="col-lg-3">
                        <ul class="my-account-nav">
                            <li><a href="/profile" class="my-account-nav-item">My Profile</a></li>                            
                            <li><a href="/profile/orders" class="my-account-nav-item">Orders</a></li>
                            <li><span class="my-account-nav-item active">Addresses</span></li>
                            <li><a href="/profile/wallet" class="my-account-nav-item ">My Wallet</a></li>
                            <li><a href="/wishlist" class="my-account-nav-item">Wishlist</a></li>
                            <li><a href="/logout" class="my-account-nav-item">Logout</a></li>
                        </ul>
                    </div>

      <div class="col-md-9">
        <div class="profile-card">
          <h6 class="mb-3">Add New Address</h6>

          <form id="add-address-form">
            <div class="row g-1">
              <!-- Address Info -->
              <div class="col-md-6">
                <small>Flat No/Building*</small>
                <input type="text" id="building" class="form-control" placeholder="Flat No/Building*" />
                <div id="error-1" class="error-message"></div>
              </div>
              <div class="col-md-6">
                <small>Street Name/Area*</small>
                <input type="text" id="street" class="form-control" placeholder="Street Name/Area*" />
                <div id="error-2" class="error-message"></div>
              </div>
              <div class="col-md-6">
                <small>Landmark</small>
                <input type="text" id="landmark" class="form-control" placeholder="Landmark" />
              </div>
              <div class="col-md-6">
                <small>Pincode*</small>
                <input type="text" id="pincode" class="form-control" placeholder="Pincode*" />
                <div id="error-3" class="error-message"></div>
              </div>
              <div class="col-md-6">
                <small>City/District*</small>
                <input type="text" id="city" class="form-control" placeholder="City/District*" />
                <div id="error-4" class="error-message"></div>
              </div>
              <div class="col-md-6">
                <small>State*</small>
                <input type="text" id="state" class="form-control" placeholder="State*" />
                <div id="error-5" class="error-message"></div>
              </div>

              <h6 class="mb-2 mt-3">Personal Information</h6>
              <div class="col-md-12">
                <small>Full Name</small>
                <input type="text" id="name" class="form-control" placeholder="Full Name" />
              </div>
              <div class="col-md-6">
                <small>Phone number*</small>
                <input type="tel" id="phone" class="form-control" placeholder="Phone number*" />
                <div id="error-6" class="error-message"></div>
              </div>
              <div class="col-md-6">
                <small>Alternative Phone number</small>
                <input type="tel" id="altPhone" class="form-control" placeholder="Alternative Phone number" />
                <div id="error-7" class="error-message"></div>
              </div>

              <h6 class="mb-2 mt-3">Save Address as</h6>
              <div class="col-md-12">
                <label class="mx-2">
                  <input type="radio" name="addressType" value="Home" />
                  <span>Home</span>
                </label>
                <label class="mx-2">
                  <input type="radio" name="addressType" value="Work" />
                  <span>Work</span>
                </label>
                <label class="mx-2">
                  <input type="radio" name="addressType" value="Other" />
                  <span>Other</span>
                </label>
                <div id="error-8" class="error-message"></div>
              </div>

              <!-- Alert Messages -->
              <div id="error-message" class="alert alert-danger d-none"></div>
              <div id="success-message" class="alert alert-success d-none"></div>

              <div class="col-12 mt-2">
                <button type="submit" class="save-btn">Save Address</button>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/validator@13.9.0/validator.min.js"></script>

<!-- form validation -->
 <script>
document.addEventListener('DOMContentLoaded', () => {
  const addressForm = document.getElementById('add-address-form');

  const fields = {
    building: document.getElementById('building'),
    street: document.getElementById('street'),
    landmark: document.getElementById('landmark'),
    pincode: document.getElementById('pincode'),
    city: document.getElementById('city'),
    state: document.getElementById('state'),
    name: document.getElementById('name'),
    phone: document.getElementById('phone'),
    altPhone: document.getElementById('altPhone'),
    addressType: () => document.querySelector('input[name="addressType"]:checked')
  };

  const errors = {
    building: document.getElementById('error-1'),
    street: document.getElementById('error-2'),
    pincode: document.getElementById('error-3'),
    city: document.getElementById('error-4'),
    state: document.getElementById('error-5'),
    phone: document.getElementById('error-6'),
    altPhone: document.getElementById('error-7'),
    addressType:document.getElementById('error-8')
  };

  const showError = (el, msg) => { el.textContent = msg; el.style.display = 'block'; };
  const hideError = (el) => { el.textContent = ''; el.style.display = 'none'; };
  const clearErrors = () => Object.values(errors).forEach(hideError);
  const namepattern = /^[A-Za-z\s]+$/;
  // Real-time validation on blur
  Object.keys(fields).forEach(key => {
    if (key !== 'addressType') {
      fields[key].addEventListener('blur', () => validateField(key));
    }
  });

  const validateField = (key) => {
    const value = fields[key].value.trim();
    switch(key) {
      case 'building':
      case 'street':
        if (validator.isEmpty(value)) showError(errors[key], `${key.charAt(0).toUpperCase() + key.slice(1)} is required`);
        else hideError(errors[key]);
        break;
      case 'pincode':
        if (validator.isEmpty(value)) showError(errors.pincode, 'Pincode is required');
        else if (!validator.isPostalCode(value, 'IN')) showError(errors.pincode, 'Invalid pincode');
        else hideError(errors.pincode);
        break;
      case 'city':
        if (validator.isEmpty(value)) showError(errors[key], `${key.charAt(0).toUpperCase() + key.slice(1)} is required`);
        
        else hideError(errors[key]);
        break;

      case 'state':
        if (validator.isEmpty(value)) showError(errors[key], `${key.charAt(0).toUpperCase() + key.slice(1)} is required`);
        if(!namepattern.test(value))showError(errors[key], ` Only alphabets are allowed`);
        else hideError(errors[key]);
        break;
      case 'phone':
        if (validator.isEmpty(value)) showError(errors.phone, 'Phone is required');
        else if (!validator.isMobilePhone(value, 'en-IN')) showError(errors.phone, 'Invalid phone number');
        else hideError(errors.phone);
        break;
      case 'altPhone':
        if (value && !validator.isMobilePhone(value, 'en-IN')) showError(errors.altPhone, 'Invalid alternate phone');
        else hideError(errors.altPhone);
        break;
    }
  };

  // Final validation on submit
  addressForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    clearErrors();
    let hasError = false;

    // Validate all fields
    Object.keys(fields).forEach(key => {
      if (key !== 'addressType') validateField(key);
      if (errors[key] && errors[key].textContent) hasError = true;
    });

    // Validate address type radio
    if (!fields.addressType()) {
      showError(errors.altPhaddressTypeone, 'Please select an address type (Home/Work/Other)')
      
      hasError = true;
    }

    if (hasError) return;

    // Prepare form data
    const formData = {
      building: fields.building.value.trim(),
      street: fields.street.value.trim(),
      landmark: fields.landmark.value.trim(),
      pincode: fields.pincode.value.trim(),
      city: fields.city.value.trim(),
      state: fields.state.value.trim(),
      name: fields.name.value.trim(),
      phone: fields.phone.value.trim(),
      altPhone: fields.altPhone.value.trim(),
      addressType: fields.addressType().value
    };

    const submitBtn = addressForm.querySelector('button[type="submit"]');
    submitBtn.disabled = true;

    try {
      const res = await axios.post('/profile/address-add', formData);
      if (res.data.status === 'success') {
        const successBox = document.getElementById('success-message');
        successBox.textContent = res.data.message || 'Address saved successfully!';
        successBox.classList.remove('d-none');
        setTimeout(() => window.location.href = res.data.redirectUrl || '/profile/address', 1200);
      }
    } catch (err) {
      const errorBox = document.getElementById('error-message');
      errorBox.textContent = err.response?.data?.message || 'Something went wrong.';
      errorBox.classList.remove('d-none');
    } finally {
      submitBtn.disabled = false;
    }
  });
});
</script>

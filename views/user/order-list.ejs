<%-include("../partials/user/header")%>

<div class="tf-breadcrumb">
    <div class="container">
        <div class="tf-breadcrumb-wrap d-flex justify-content-between flex-wrap align-items-center">
            <div class="tf-breadcrumb-list">
                <a href="/" class="text">Home</a>
                <i class="icon icon-arrow-right"></i>
                <span class="text">Orders</span>
            </div>
        </div>
    </div>
</div>

<section class="flat-spacing-11">
    <div class="container">
        <div class="row">
            <div class="col-lg-3">

                <!-- Left Navigation -->
                <ul class="my-account-nav">
                    <li><a href="/profile" class="my-account-nav-item">My Profile</a></li>
                    <li><span class="my-account-nav-item active">Orders</span></li>
                    <li><a href="/profile/address" class="my-account-nav-item">Addresses</a></li>
                    <li><a href="/profile/wallet" class="my-account-nav-item">My Wallet</a></li>
                    <li><a href="/wishlist" class="my-account-nav-item">Wishlist</a></li>
                    <li><a href="/logout" class="my-account-nav-item">Logout</a></li>
                </ul>

            </div>
            <div class="col-lg-9">
                <div class="my-account-content account-order">

                    <!-- FILTERS -->
                    <div class="order-0 col-lg-12 mb-3 mb-md-4 d-flex justify-content-between align-items-start flex-wrap">

                        <!-- Search + Filters -->
                        <div>
                            <form method="GET" action="/profile/orders-summary"
                                  class="d-flex flex-wrap justify-content-start align-items-center gap-3">

                                <!-- Search -->
                                <div class="input-group input-group-sm" style="max-width: 280px;">
                                    <input type="search" name="search" class="form-control"
                                           placeholder="Search by Order ID..." value="<%= searchQuery %>">
                                    <button type="submit" class="input-group-text">
                                        <i class="icofont-search"></i>
                                    </button>

                                    <% if (searchQuery) { %>
                                        <a href="/profile/orders-summary" class="input-group-text bg-danger text-white">
                                            <i class="icofont-close"></i>
                                        </a>
                                    <% } %>
                                </div>

                                <!-- Status Filter -->
                                <div class="d-flex flex-wrap align-items-center gap-2">
                                    <select name="status" class="form-select form-select-sm" style="max-width:180px;">
                                        <option value="">All Statuses</option>
                                        <% ['Pending','Processing','Shipped','Out for Delivery','Delivered','Cancelled','Return Request','Return Approved','Return Rejected','Returned']
                                            .forEach(st => { %>
                                            <option value="<%= st %>" <%= statusFilter === st ? 'selected' : '' %>>
                                                <%= st %>
                                            </option>
                                        <% }); %>
                                    </select>
                                </div>

                                <div class="d-flex flex-wrap align-items-center gap-2">
                                    <button type="submit" class="btn btn-sm btn-primary">Apply Filters</button>
                                    <a href="/profile/orders-summary" class="btn btn-sm btn-secondary">Reset</a>
                                </div>

                            </form>
                        </div>

                        <!-- VIEW MODE DROPDOWN -->
                        <div class="d-flex gap-2">
                            <select id="viewMode" class="form-select form-select-sm" style="max-width:180px;">
                                <option value="/profile/orders-summary">Order Wise</option>
                                <option value="/profile/orders">Item Wise</option>
                            </select>
                        </div>

                    </div>

                    <!-- ORDER LIST -->
                    <% if (orders.length > 0) { %>
                        <div class="wrap-account-order">
                            <table>
                                <thead>
                                <tr>
                                    <th class="fw-6">Order</th>
                                    <th class="fw-6">Date</th>
                                    <th class="fw-6">Status</th>
                                    <th class="fw-6">Total</th>
                                    <th class="fw-6">Actions</th>
                                </tr>
                                </thead>

                                <tbody>
                                <% orders.forEach(order => { %>
                                    <tr class="tf-cart-item">

                                        <!-- Order Thumbnail + ID -->
                                        <td class="tf-cart-item_product">
                                            <a href="/profile/allorder-details/<%= order.orderId %>" class="img-box">
                                                <img src="<%= order.thumbnail %>" alt="Order Image">
                                            </a>
                                            <div class="cart-info">
                                                <a href="/profile/allorder-details/<%= order.orderId %>"
                                                   class="cart-title link">
                                                    Order <%= order.orderId %>
                                                </a>
                                                <div class="cart-meta-variant text-muted" style="font-size: 12px;">
                                                    <%= order.itemCount %> items
                                                </div>
                                            </div>
                                        </td>

                                        <!-- Date -->
                                        <td>
                                            <%= new Date(order.orderDate).toLocaleDateString('en-US', {
                                                year: 'numeric', month: 'long', day: 'numeric'
                                            }) %>
                                        </td>

                                        <!-- Status -->
                                        <td>
                                            <span class="badge
                                                <%= order.status === 'Delivered'|| order.status === 'Return Approved' ? 'bg-success' : '' %>
                                                            <%= order.status === 'Cancelled'|| order.status === 'Return Rejected' ? 'bg-danger' : '' %>
                                                            <%= order.status === 'Pending' || order.status === 'Processing' ? 'bg-warning' : '' %>
                                                            <%= order.status === 'Shipped' || order.status === 'Out for Delivery' ? 'bg-info' : '' %>
                                                            <%= order.status === 'Returned' || order.status === 'Return Request' ? 'bg-secondary' : '' %>
                                                            <%= order.status === 'Returned' || order.status === 'Return Request' ? 'bg-secondary' : '' %>
                                                            <%= order.status === 'Returned' || order.status === 'Return Request' ? 'bg-secondary' : '' %>
                                            ">
                                                <%= order.status %>
                                            </span>
                                        </td>

                                        <!-- Total -->
                                        <td class="tf-cart-item_price">
                                            <div class="cart-price">₹<%= order.totalAmount.toLocaleString('en-IN') %></div>
                                        </td>

                                        <!-- Actions -->
                                        <td>
                                            <a href="/profile/allorder-details/<%= order.orderId %>"
                                               class="tf-btn btn-fill animate-hover-btn rounded-0 justify-content-center">
                                                <span>View</span>
                                            </a>
                                        </td>

                                    </tr>
                                <% }); %>
                                </tbody>

                            </table>
                        </div>

                        <!-- PAGINATION -->
                        <% if (pagination.totalPages > 1) { %>
                            <ul class="tf-pagination-wrap tf-pagination-list mt-4">

                                <% if (pagination.hasPrevPage) { %>
                                    <li>
                                        <a href="/profile/orders-summary?page=<%= pagination.prevPage %>"
                                           class="pagination-link animate-hover-btn">
                                            <span class="icon icon-arrow-left"></span>
                                        </a>
                                    </li>
                                <% } %>

                                <% pagination.pages.forEach(pageNum => { %>
                                    <li class="<%= pageNum === pagination.currentPage ? 'active' : '' %>">
                                        <a href="/profile/orders-summary?page=<%= pageNum %>"
                                           class="pagination-link <%= pageNum === pagination.currentPage ? '' : 'animate-hover-btn' %>">
                                            <%= pageNum %>
                                        </a>
                                    </li>
                                <% }); %>

                                <% if (pagination.hasNextPage) { %>
                                    <li>
                                        <a href="/profile/orders-summary?page=<%= pagination.nextPage %>"
                                           class="pagination-link animate-hover-btn">
                                            <span class="icon icon-arrow-right"></span>
                                        </a>
                                    </li>
                                <% } %>

                            </ul>
                        <% } %>

                    <% } else { %>

                        <!-- EMPTY STATE -->
                        <div style="text-align: center; padding: 60px 20px;">
                            <i class="icofont-shopping-cart" style="font-size: 64px; color: #ccc; margin-bottom: 20px;"></i>
                            <h4 style="color: #666; margin-bottom: 10px;">
                                <% if (searchQuery) { %>
                                    No orders found for "<%= searchQuery %>"
                                <% } else { %>
                                    No orders yet
                                <% } %>
                            </h4>
                            <p style="color: #999; margin-bottom: 20px;">
                                <% if (searchQuery) { %>
                                    Try searching with a different term
                                <% } else { %>
                                    Start shopping to see your orders here
                                <% } %>
                            </p>

                            <% if (searchQuery) { %>
                                <a href="/profile/orders-summary"
                                   class="tf-btn btn-fill animate-hover-btn radius-3">
                                    <span>View All Orders</span>
                                </a>
                            <% } else { %>
                                <a href="/shop" class="tf-btn btn-fill animate-hover-btn radius-3">
                                    <span>Start Shopping</span>
                                </a>
                            <% } %>
                        </div>

                    <% } %>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- JS: View Mode Redirect -->
<script>
document.addEventListener("DOMContentLoaded", function () {
    const select = document.getElementById("viewMode");
    const path = window.location.pathname;

    select.value = path.includes("orders-summary")
        ? "/profile/orders-summary"
        : "/profile/orders";

    select.addEventListener("change", function () {
        window.location.href = this.value;
    });
});
</script>

<%-include("../partials/user/footer")%>

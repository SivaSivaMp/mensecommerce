<%-include("../partials/user/header")%>

<div class="tf-page-title">
  <div class="container-full">
    <div class="heading text-center"><i class="icofont-tick-mark"></i>Thank You for Purchasing With Us!</div>
  </div>
</div>

<section class="flat-spacing-11">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-8">
        <div class="tf-page-cart-checkout">
          <h4 class="fw-bold mb-3 text-center text-success">🎉 Order Placed Successfully!</h4>
          <div class="d-flex justify-content-between mb-2">
            <div>Order ID:</div>
            <div><%= order.orderId %></div>
          </div>
          <div class="d-flex justify-content-between mb-2">
            <div>Date:</div>
            <div><%= new Date(order.createdAt).toLocaleDateString() %></div>
          </div>
          <div class="d-flex justify-content-between mb-2">
            <div>Payment Method:</div>
            <div><%= order.paymentMethod === 'cod' ? 'Cash on Delivery' : 'Online Payment' %></div>
          </div>
          <div class="d-flex justify-content-between mb-2">
            <div>Status:</div>
            <div><%= order.status %></div>
          </div>

          <hr>

          <h5 class="mt-3 mb-2">Shipping Address</h5>
          <p><strong><%= order.shippingAddress.name %></strong></p>
          <p>
            <%= order.shippingAddress.building %>, <%= order.shippingAddress.street %><br>
            <%= order.shippingAddress.city %>, <%= order.shippingAddress.state %> - <%= order.shippingAddress.pincode %><br>
            📞 <%= order.shippingAddress.phone %>
          </p>

          <hr>

          <h5 class="mt-3 mb-2">Items Ordered</h5>
          <% order.orderedItems.forEach(item => { %>
            <div class="d-flex justify-content-between border-bottom py-2">
              <span><%= item.productName %> (<%= item.size %>) × <%= item.quantity %></span>
              <span>₹<%= (item.price * item.quantity).toLocaleString('en-IN') %></span>
            </div>
          <% }) %>
          <% if (order.discount) { %>
            <div class="d-flex justify-content-between border-bottom py-2">
              <span>discount:  </span>
              <span style="color: rgb(50, 200, 50);">-₹<%= order.discount %></span>
            </div>
            <% } %>
           <% if (order.couponCode) { %>
            <div class="d-flex justify-content-between border-bottom py-2">
              <span>coupon applied: <%= order.couponCode %> </span>
              <span style="color: rgb(50, 200, 50);">-₹<%= order.couponDiscount %></span>
            </div>
            <% } %>

          <div class="d-flex justify-content-between mt-3 fw-bold fs-5">
            <span>Total Amount:</span>
            <span>₹<%= order.finalAmount.toLocaleString('en-IN') %></span>
          </div>

          <div class="text-center mt-4">
            <a href="/profile/orders" class="tf-btn btn-fill animate-hover-btn radius-3">
              <span>View My Orders</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<%-include("../partials/user/footer")%>

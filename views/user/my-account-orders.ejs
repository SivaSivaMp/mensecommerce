<%-include("../partials/user/header")%>
<div class="tf-breadcrumb">
            <div class="container">
                <div class="tf-breadcrumb-wrap d-flex justify-content-between flex-wrap align-items-center">
                    <div class="tf-breadcrumb-list">
                        <a href="/" class="text">Home</a>
                        <i class="icon icon-arrow-right"></i>
                        <span class="text">Orders</span>
                    </div> 
                </div>
            </div>
        </div>
        
        <!-- page-cart -->
        <section class="flat-spacing-11">
            <div class="container">
                <div class="row">
                    <div class="col-lg-3">
                        <ul class="my-account-nav">
                            <li><a href="/profile/address" class="my-account-nav-item">My Profile</a></li>                            
                            <li><a href="/profile/orders" class="my-account-nav-item">Orders</a></li>
                            <li><a href="/profile/address" class="my-account-nav-item">Addresses</a></li>
                            <li><a href="my-account.html" class="my-account-nav-item ">My Wallet</a></li>
                            <li><a href="/wishlist" class="my-account-nav-item">Wishlist</a></li>
                            <li><a href="/logout" class="my-account-nav-item">Logout</a></li>
                        </ul>
                    </div>
                    <div class="col-lg-9">
                        <div class="my-account-content account-order">
                            <!-- Search Bar -->
                            <div class="order-0 col-lg-12 mb-3 mb-md-4">
                            <form method="GET" action="/profile/orders"
                                    class="d-flex flex-wrap justify-content-start align-items-center gap-3">

                                <!-- LEFT SIDE: Search -->
                                <div class="input-group input-group-sm" style="max-width: 280px;">
                                <input type="search" name="search" class="form-control"
                                        placeholder="Search by Order ID or Name..." value="<%= searchQuery %>">
                                <button type="submit" class="input-group-text">
                                    <i class="icofont-search"></i>
                                </button>
                                <% if (searchQuery) { %>
                                    <a href="/admin/orders" class="input-group-text bg-danger text-white">
                                    <i class="icofont-close"></i>
                                    </a>
                                <% } %>
                                </div>

                                <!-- RIGHT SIDE: Filters + Buttons -->
                                <div class="d-flex flex-wrap align-items-center gap-2">
                                <select name="status" class="form-select form-select-sm" style="max-width:180px;">
                                    <option value="">All Statuses</option>
                                    <% ['Pending', 'Processing', 'Shipped', 'Out for Delivery', 'Delivered', 'Cancelled', 'Return Request', 'Return Approved', 'Return Rejected', 'Returned'].forEach(st => { %>
                                    <option value="<%= st %>" <%= statusFilter === st ? 'selected' : '' %>><%= st %></option>
                                    <% }); %>
                                </select>
                                </div>
                                 <div class="d-flex flex-wrap align-items-center gap-2">
                                
                                <button type="submit" class="btn btn-sm btn-primary">Apply Filters</button>
                                <a href="/profile/orders" class="btn btn-sm btn-secondary">Reset</a>
                                </div>

                            </form>
                            </div>

                            

                            <% if (orders.length > 0) { %>
                                <div class="wrap-account-order">
                                    <table>
                                        <thead>
                                            <tr>
                                                <th class="fw-6">Product</th>
                                                <th class="fw-6">Date</th>
                                                <th class="fw-6">Status</th>
                                                <th class="fw-6">Total</th>
                                                <th class="fw-6">Actions</th>
                                                <th class="fw-6">Feedback</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% orders.forEach((order) => { %>
                                                <tr class="tf-cart-item">
                                                    <td class="tf-cart-item_product">
                                                        <a href="/profile/order-details/<%= order.orderId %>" class="img-box">
                                                            <img src="<%= order.productImage %>" alt="<%= order.productName %>">
                                                        </a>
                                                        <div class="cart-info">
                                                            <a href="/profile/order-details/<%= order.orderId %>/<%= order.itemId %>" class="cart-title link"><%= order.productName %></a>
                                                            <div class="cart-meta-variant"><%= order.size %> / Qty: <%= order.quantity %></div>
                                                            <div class="cart-meta-variant text-muted" style="font-size: 12px;">Order ID: <%= order.orderId %></div>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <%= new Date(order.orderDate).toLocaleDateString('en-US', { 
                                                            year: 'numeric', 
                                                            month: 'long', 
                                                            day: 'numeric' 
                                                        }) %>
                                                    </td>
                                                    <td>
                                                        <span class="badge 
                                                            <%= order.status === 'Delivered'|| order.status === 'Return Approved' ? 'bg-success' : '' %>
                                                            <%= order.status === 'Cancelled'|| order.status === 'Return Rejected' ? 'bg-danger' : '' %>
                                                            <%= order.status === 'Pending' || order.status === 'Processing' ? 'bg-warning' : '' %>
                                                            <%= order.status === 'Shipped' || order.status === 'Out for Delivery' ? 'bg-info' : '' %>
                                                            <%= order.status === 'Returned' || order.status === 'Return Request' ? 'bg-secondary' : '' %>
                                                            <%= order.status === 'Returned' || order.status === 'Return Request' ? 'bg-secondary' : '' %>
                                                            <%= order.status === 'Returned' || order.status === 'Return Request' ? 'bg-secondary' : '' %>
                                                        ">
                                                            <%= order.status %>
                                                        </span>
                                                    </td>
                                                    <td class="tf-cart-item_price">
                                                        <div class="cart-price">₹<%= order.totalPrice.toLocaleString('en-IN') %></div>
                                                    </td>
                                                    <td>
                                                        <a href="/profile/order-details/<%= order.orderId %>/<%= order.itemId %>" class="tf-btn btn-fill animate-hover-btn rounded-0 justify-content-center">
                                                            <span>View</span>
                                                        </a>
                                                    </td>
                                                    <td>
                                                        <% if (order.canReview) { %>
                                                            <a href="/profile/feedback/<%= order.orderMongoId %>" class="cart-title link">Rate & Review</a>
                                                        <% } else { %>
                                                            <span class="text-muted">-</span>
                                                        <% } %>
                                                    </td>
                                                </tr>
                                            <% }); %>
                                        </tbody>
                                    </table>
                                </div>

                                <!-- Pagination -->
                                <% if (pagination.totalPages > 1) { %>
                                    <ul class="tf-pagination-wrap tf-pagination-list mt-4">
                                        <!-- Previous Button -->
                                        <% if (pagination.hasPrevPage) { %>
                                            <li>
                                                <a href="/profile/orders?page=<%= pagination.prevPage %><%= searchQuery ? '&query=' + encodeURIComponent(searchQuery) : '' %>" class="pagination-link animate-hover-btn">
                                                    <span class="icon icon-arrow-left"></span>
                                                </a>
                                            </li>
                                        <% } %>

                                        <!-- Page Numbers -->
                                        <% pagination.pages.forEach((pageNum) => { %>
                                            <li class="<%= pageNum === pagination.currentPage ? 'active' : '' %>">
                                                <a href="/profile/orders?page=<%= pageNum %><%= searchQuery ? '&query=' + encodeURIComponent(searchQuery) : '' %>" class="pagination-link <%= pageNum === pagination.currentPage ? '' : 'animate-hover-btn' %>">
                                                    <%= pageNum %>
                                                </a>
                                            </li>
                                        <% }); %>

                                        <!-- Next Button -->
                                        <% if (pagination.hasNextPage) { %>
                                            <li>
                                                <a href="/profile/orders?page=<%= pagination.nextPage %><%= searchQuery ? '&query=' + encodeURIComponent(searchQuery) : '' %>" class="pagination-link animate-hover-btn">
                                                    <span class="icon icon-arrow-right"></span>
                                                </a>
                                            </li>
                                        <% } %>
                                    </ul>
                                <% } %>
                            <% } else { %>
                                <div style="text-align: center; padding: 60px 20px;">
                                    <i class="icofont-shopping-cart" style="font-size: 64px; color: #ccc; margin-bottom: 20px;"></i>
                                    <h4 style="color: #666; margin-bottom: 10px;">
                                        <% if (searchQuery) { %>
                                            No orders found for "<%= searchQuery %>"
                                        <% } else { %>
                                            No orders yet
                                        <% } %>
                                    </h4>
                                    <p style="color: #999; margin-bottom: 20px;">
                                        <% if (searchQuery) { %>
                                            Try searching with a different term
                                        <% } else { %>
                                            Start shopping to see your orders here
                                        <% } %>
                                    </p>
                                    <% if (searchQuery) { %>
                                        <a href="/profile/orders" class="tf-btn btn-fill animate-hover-btn radius-3">
                                            <span>View All Orders</span>
                                        </a>
                                    <% } else { %>
                                        <a href="/shop" class="tf-btn btn-fill animate-hover-btn radius-3">
                                            <span>Start Shopping</span>
                                        </a>
                                    <% } %>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </section>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>

        <script>
            document.addEventListener('DOMContentLoaded', function() {
                const clearButton = document.getElementById('clear-search');
                if (clearButton) {
                    clearButton.addEventListener('click', function() {
                        window.location.href = '/profile/orders';
                    });
                }
            });
        </script>
<script>
document.addEventListener("DOMContentLoaded", function () {
    const reviewLinks = document.querySelectorAll('a[href^="/profile/feedback/"]');

    reviewLinks.forEach(link => {
        link.addEventListener('click', async (event) => {
            event.preventDefault();
            const orderId = link.getAttribute('href').split('/').pop(); // Extract orderMongoId

            const { value: formValues } = await Swal.fire({
                title: 'Rate & Review',
                html: `
                    <input id="swal-title" class="swal2-input" placeholder="Enter a short title">
                    <label style="font-size: 14px; margin-top: 10px;">Rating (1–5):</label>
                    <input id="swal-rating" type="number" min="1" max="5" class="swal2-input" placeholder="e.g., 4">
                    <textarea id="swal-review" class="swal2-textarea" placeholder="Write your review here..." style="height: 100px;"></textarea>
                `,
                focusConfirm: false,
                showCancelButton: true,
                confirmButtonText: 'Submit Review',
                preConfirm: () => {
                    const title = document.getElementById('swal-title').value.trim();
                    const rating = Number(document.getElementById('swal-rating').value);
                    const review = document.getElementById('swal-review').value.trim();

                    if (!title || !rating || !review) {
                        Swal.showValidationMessage('Please fill out all fields');
                        return false;
                    }
                    if (rating < 1 || rating > 5) {
                        Swal.showValidationMessage('Rating must be between 1 and 5');
                        return false;
                    }

                    return { title, rating, review };
                }
            });

            if (formValues) {
                try {
                    const response = await axios.post(`/profile/feedback/${orderId}`, formValues);
                    if (response.data.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Thank you!',
                            text: 'Your review has been submitted successfully.',
                            confirmButtonColor: '#3085d6'
                        }).then(() => {
                            window.location.reload(); // Refresh to update UI
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Oops!',
                            text: response.data.message || 'Something went wrong while submitting your review.',
                        });
                    }
                } catch (error) {
                    console.error(error);
                    Swal.fire({
                        icon: 'error',
                        title: 'Error!',
                        text: error.response?.data?.message || 'Failed to submit review. Please try again later.',
                    });
                }
            }
        });
    });
});
</script>


<%-include("../partials/user/footer")%>
                        <a href="/" class="text">Home</a>
                        <i class="icon icon-arrow-right"></i>
                        <a href="/shop" class="text">shop</a>
                        <i class="icon icon-arrow-right"></i>
                        <span class="text"><%=product.name%></span>
                    </div>
                    <div class="tf-breadcrumb-prev-next">
                        <a href="#" class="tf-breadcrumb-prev hover-tooltip center">
                            <i class="icon icon-arrow-left"></i>
                        </a>
                        <a href="#" class="tf-breadcrumb-back hover-tooltip center">
                            <i class="icon icon-shop"></i>
                        </a>
                        <a href="#" class="tf-breadcrumb-next hover-tooltip center">
                            <i class="icon icon-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
        <!-- /breadcrumb -->
        <!-- default -->
   <section class="flat-spacing-4 pt_0">
    <div class="tf-main-product section-image-zoom">
        <div class="container">
            <div class="row">
                <!-- Image Gallery -->
                <div class="col-md-6">
                    <div class="tf-product-media-wrap sticky-top">
                        <div class="thumbs-slider">
                            <!-- Thumbnails -->
                            <div class="swiper tf-product-media-thumbs other-image-zoom" data-direction="vertical">
                                <div class="swiper-wrapper stagger-wrap">
                                    <% if (product.images && product.images.length > 0) { %>
                                        <% product.images.forEach(function(img) { %>
                                            <div class="swiper-slide stagger-item">
                                                <div class="item">
                                                    <img class="lazyload" data-src="<%= img %>" src="<%= img %>" alt="<%= product.name %>">
                                                </div>
                                            </div>
                                        <% }); %>
                                    <% } %>
                                </div>
                            </div>
                            
                            <!-- Main Images -->
                            <div class="swiper tf-product-media-main" id="gallery-swiper-started">
                                <div class="swiper-wrapper">
                                    <% if (product.images && product.images.length > 0) { %>
                                        <% product.images.forEach(function(img) { %>
                                            <div class="swiper-slide">
                                                <a href="<%= img %>" target="_blank" class="item" data-pswp-width="770px" data-pswp-height="1075px">
                                                    <img class="tf-image-zoom-magnifier drift-demo-trigger lazyload" data-zoom="<%= img %>" data-src="<%= img %>" src="<%= img %>" alt="<%= product.name %>">
                                                </a>
                                            </div>
                                        <% }); %>
                                    <% } %>
                                </div>
                                <div class="swiper-button-next button-style-arrow thumbs-next"></div>
                                <div class="swiper-button-prev button-style-arrow thumbs-prev"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Product Info -->
                <div class="col-md-6">
                    <div class="tf-product-info-wrap position-relative">
                        <div class="tf-zoom-main"></div>
                        <div class="tf-product-info-list other-image-zoom">
                            <!-- Title -->
                            <div class="tf-product-info-title">
                                <h5><%= product.name %></h5>
                            </div>
                            
                            <!-- Price -->
                            <div class="tf-product-info-price">
                                <div class="price-on-sale">₹<%= product.salesPrice.toFixed(2) %></div>
                                <div class="compare-at-price">₹<%= product.originalPrice.toFixed(2) %></div>
                                <div class="badges-on-sale">
                                    <span><%=product.discountPercentage %></span>% OFF
                                </div>
                            </div>

                            <!-- Variant Picker -->
                            <div class="tf-product-info-variant-picker">
                                <!-- Color Selection - Only if color data exists -->
                                <% if (product.colorName) { %>
                                <div class="variant-picker-item">
                                    <div class="variant-picker-label" >
                                        Color: <span class="fw-6 variant-picker-label-value" ><%= product.colorName %></span>
                                    </div>
                                    <div class="variant-picker-values">
                                        <input type="radio" name="color" id="color-<%= product.colorName %>" value="<%= product.colorName %>" checked>
                                        <label class="style-text" for="color-<%= product.colorName %>" data-value="<%= product.colorName %>">
                                            <p><%= product.colorName %></p>
                                        </label>

                                    </div>
                                </div>
 
                                <% } %>
                              
                                <!-- Size Selection -->
                                <div class="variant-picker-item">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div class="variant-picker-label">
                                            Size: <span class="fw-6 variant-picker-label-value" id="selected-size"><%= availableSizes[0]?.label || '' %></span>
                                        </div>
                                        
                                    </div>

                                    <div class="variant-picker-values">
                                        <% if (availableSizes && availableSizes.length > 0) { %>
                                            <% availableSizes.forEach(function(size, index) { %>
                                                <input type="radio" 
                                                       name="size" 
                                                       id="size-<%= size.label %>" 
                                                       value="<%= size.label %>"
                                                       data-stock="<%= size.stock %>"
                                                       <%= index === 0 ? 'checked' : '' %>
                                                       <%= size.stock === 0 ? 'disabled' : '' %>>
                                                <label class="style-text <%= size.stock === 0 ? 'sold-out' : '' %>" 
                                                       for="size-<%= size.label %>" 
                                                       data-value="<%= size.label %>">
                                                    <p><%= size.label %></p>
                                                    <% if (size.isLowStock && size.stock > 0) { %>
                                                        <small class="text-danger">Only <%= size.stock %> left</small>
                                                    <% } else if (size.stock === 0) { %>
                                                        <small class="text-muted">Sold out</small>
                                                    <% } %>
                                                </label>
                                            <% }); %>
                                        <% } else { %>
                                            <p>No sizes available</p>
                                        <% } %>
                                    </div>
                                </div>
                            </div>

                           
                            <div class="variant-picker-label">
                                total stock: <span class="fw-6 variant-picker-label-value" id="selected-size"><%=product.totalStock%></span><br>
                                category: <span class="fw-6 variant-picker-label-value" id="selected-size"><%=product.category.categoryName%></span>
                            </div>                            
                           
                            <!-- Buy Buttons -->
                            <div class="tf-product-info-buy-button">
                                <form  id="add-to-cart-form">
                                    <input type="hidden" name="productId" id="cart-productId" value="<%= product._id %>">
                                    <input type="hidden" name="color" id="form-color" value="<%= product.colorName || '' %>">
                                    <input type="hidden" name="size" id="form-size" value="<%= availableSizes?.[0]?.label || '' %>">
                                    <input type="hidden" name="quantity" id="form-quantity" value="1">
                                    
                                    <button type="button" id="addToCartBtn" class="tf-btn btn-fill justify-content-center fw-6 fs-16 flex-grow-1 animate-hover-btn">
                                        <span>Add to cart </span>
                                    </button>
                                    
                                    <button type="button" id="addToWishlistBtn" class="tf-product-btn-wishlist hover-tooltip box-icon bg_white wishlist btn-icon-action" >
                                        <span class="icon icon-heart"></span>
                                        <span class="tooltip">Add to Wishlist</span>
                                        <span class="icon icon-delete"></span>
                                    </button>
                                </form>
                                
                            </div>
                            <!-- Delivery Info -->
                            <div class="tf-product-info-delivery-return">
                                <div class="row">
                                    <div class="col-xl-6 col-12">
                                        <div class="tf-product-delivery">
                                            <div class="icon">
                                                <i class="icon-delivery-time"></i>
                                            </div>
                                            <p>Estimate delivery times: <span class="fw-7">12-26 days</span> (International), <span class="fw-7">3-6 days</span> (United States).</p>
                                        </div>
                                    </div>
                                    <div class="col-xl-6 col-12">
                                        <div class="tf-product-delivery mb-0">
                                            <div class="icon">
                                                <i class="icon-return-order"></i>
                                            </div>
                                            <p>Return within <span class="fw-7">30 days</span> of purchase. Duties & taxes are non-refundable.</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
        <!-- /default -->
        <!-- tabs -->
        <section class="flat-spacing-17 pt_0">
            <div class="container">
                <div class="row">
                    <div class="col-12">
                        <div class="widget-tabs style-has-border">
                            <ul class="widget-menu-tab">
                                <li class="item-title active">
                                    <span class="inner">Description</span>
                                </li>
                                <li class="item-title">
                                    <span class="inner">Review</span>
                                </li>
                                
                            </ul>
                            <div class="widget-content-tab">
                                <div class="widget-content-inner active">
                                    <div class="">
                                        <p class="mb_30"><%=product.description%>
                                        </p>
                                    </div>
                                </div>
    

<div class="widget-content-inner">
    <!-- Overall Rating Summary -->
<div class="review-rating-summary">
    <div class="rating-overview">
        <div class="rating-number"><%= avgRating %></div>

        <div class="rating-stars">
            <% for (let i = 1; i <= 5; i++) { %>
                <% if (i <= Math.floor(avgRating)) { %>
                    <i class="icon-star"></i>
                <% } else if (i - avgRating < 1) { %>
                    <i class="icon-star-half"></i>
                <% } else { %>
                    <i class="icon-star-line"></i>
                <% } %>
            <% } %>
        </div>

        <div class="rating-count">Based on <%= totalReviews %> review(s)</div>
    </div>
</div>

    <!-- Individual Reviews -->
<div class="reviews-list">

    <% if (reviews.length === 0) { %>
        <p class="text-muted mt-3">No reviews yet.</p>
    <% } %>

    <% reviews.forEach(r => { %>
        <div class="review-item">
            <div class="review-header">
                <div class="review-rating-badge"><%= r.rating %> ★</div>
                <h4 class="review-title"><%= r.title %></h4>
            </div>

            <p class="review-text"><%= r.review %></p>

            <div class="review-footer">
                <span class="reviewer-name"><%= r.userId?.name || "User" %></span>

                <span class="verified-badge">
                    <i class="icon-check"></i> Verified Buyer
                </span>

                <span class="review-date">
                    <%= r.createdAt.toLocaleDateString('en-IN', {
                        day: 'numeric',
                        month: 'short',
                        year: 'numeric'
                    }) %>
                </span>
            </div>
        </div>
    <% }) %>
</div>
</div>

<%-include("../partials/user/header")%>
<style>
/* Rating Summary */
.review-rating-summary {
    text-align: center;
    padding: 25px 0;
    border-bottom: 1px solid #e5e5e5;
    margin-bottom: 25px;
}

.rating-overview {
    display: inline-block;
}

.rating-number {
    font-size: 48px;
    font-weight: 700;
    color: #333;
    line-height: 1;
    margin-bottom: 10px;
}

.rating-stars {
    margin-bottom: 8px;
}

.rating-stars i {
    color: #ffa800;
    font-size: 20px;
    margin: 0 2px;
}

.rating-count {
    font-size: 14px;
    color: #666;
}

/* Reviews List */
.reviews-list {
    display: flex;
    flex-direction: column;
    gap: 20px;
}

.review-item {
    padding: 20px 0;
    border-bottom: 1px solid #f0f0f0;
}

.review-item:last-child {
    border-bottom: none;
}

.review-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
}

.review-rating-badge {
    background-color: #388e3c;
    color: white;
    padding: 4px 10px;
    border-radius: 4px;
    font-size: 13px;
    font-weight: 600;
}

.review-title {
    margin: 0;
    font-size: 16px;
    font-weight: 600;
    color: #333;
}

.review-text {
    color: #333;
    line-height: 1.6;
    margin: 0 0 12px 0;
    font-size: 14px;
}

.review-footer {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 12px;
    font-size: 13px;
}

.reviewer-name {
    font-weight: 600;
    color: #333;
}

.verified-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: #666;
}

.verified-badge i {
    color: #388e3c;
    font-size: 12px;
}

.review-location,
.review-date {
    color: #999;
}

.review-location::before,
.review-date::before {
    content: "•";
    margin: 0 4px;
    color: #ddd;
}

.review-actions {
    display: flex;
    gap: 15px;
}

.review-action-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: none;
    border: none;
    color: #666;
    font-size: 13px;
    cursor: pointer;
    padding: 4px 8px;
    border-radius: 4px;
    transition: all 0.2s;
}

.review-action-btn:hover {
    background-color: #f5f5f5;
    color: #333;
}

.review-action-btn i {
    font-size: 14px;
}

/* Responsive */
@media (max-width: 768px) {
    .rating-number {
        font-size: 36px;
    }
    
    .rating-stars i {
        font-size: 18px;
    }
    
    .review-header {
        flex-wrap: wrap;
    }
}
</style>

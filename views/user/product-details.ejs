        <section class="flat-spacing-1 pt_0">
    <div class="container">
        <div class="flat-title">
            <span class="title">People Also Bought</span>
        </div>
        <div class="hover-sw-nav hover-sw-2">
            <div class="swiper tf-sw-product-sell wrap-sw-over" data-preview="4" data-tablet="3" data-mobile="2" data-space-lg="30" data-space-md="15" data-pagination="2" data-pagination-md="3" data-pagination-lg="3">
                <div class="swiper-wrapper">
                    <% if (similarProducts && similarProducts.length > 0) { %>
                        <% similarProducts.forEach(function(product, i) { %>
                        <div class="swiper-slide" lazy="true">
                            <div class="card-product">
                                <div class="card-product-wrapper">
                                    <a href="/product-details?id=<%= product._id %>" class="product-img">
                                        <img class="lazyload img-product"
                                            data-src="<%= product.images && product.images[0] ? product.images[0] : '/images/placeholder.jpg' %>"
                                            src="<%= product.images && product.images[0] ? product.images[0] : '/images/placeholder.jpg' %>"
                                            alt="<%= product.name %>">

                                        <% if (product.images && product.images.length > 1) { %>
                                        <img class="lazyload img-hover"
                                            data-src="<%= product.images[1] %>"
                                            src="<%= product.images[1] %>"
                                            alt="<%= product.name %>">
                                        <% } %>
                                    </a>

                                    <% if (product.totalQuantity === 0) { %>
                                    <div class="sold-out"><span>Sold out</span></div>
                                    <% } %>

                                    <div class="list-product-btn">
                                       
                                        <a href="javascript:void(0);" 
                                           data-product-id="<%= product._id %>"
                                           class="box-icon bg_white wishlist btn-icon-action">
                                            <span class="icon icon-heart"></span>
                                            <span class="tooltip">Add to Wishlist</span>
                                            <span class="icon icon-delete"></span>
                                        </a>
                                        <a href="/product-details?id=<%= product._id %>" 
                                           class="box-icon bg_white quickview tf-btn-loading">
                                            <span class="icon icon-view"></span>
                                            <span class="tooltip">Quick View</span>
                                        </a>
                                    </div>

                                    <% if (product.availableSizes && product.availableSizes.length > 0) { %>
                                    <div class="size-list">
                                        <% product.availableSizes.forEach(function(size) { %>
                                        <span><%= size %></span>
                                        <% }); %>
                                    </div>
                                    <% } %>

                                    <% if (product.discount && product.discount > 0) { %>
                                    <div class="on-sale-wrap text-end">
                                        <div class="on-sale-item">-<%= product.discount %>%</div>
                                    </div>
                                    <% } %>
                                </div>

                                <div class="card-product-info">
                                    <a href="/product-details?id=<%= product._id %>" class="title link">
                                        <%= product.name %>
                                    </a>
                                    <span class="price">
                                        <% if (product.salesPrice && product.salesPrice < product.originalPrice) { %>
                                            <span class="text-muted text-decoration-line-through">₹<%= product.originalPrice.toFixed(2) %></span>
                                            ₹<%= product.salesPrice.toFixed(2) %>
                                        <% } else { %>
                                            ₹<%= product.originalPrice.toFixed(2) %>
                                        <% } %>
                                    </span>

                                    <% if (product.variants && product.variants.length > 0) { %>
                                    <%
                                        // Get unique colors from variants
                                        const uniqueColors = [...new Map(
                                            product.variants
                                                .filter(v => v.color && v.quantity > 0)
                                                .map(v => [v.color, v])
                                        ).values()].slice(0, 5);
                                    %>
                                    <% if (uniqueColors.length > 0) { %>
                                    <ul class="list-color-product">
                                        <% uniqueColors.forEach(function(variant, index) { %>
                                        <li class="list-color-item color-swatch <%= index === 0 ? 'active' : '' %>">
                                            <span class="tooltip"><%= variant.color %></span>
                                            <span class="swatch-value" 
                                                  style="background-color:<%= variant.colorCode || '#000' %>;"></span>
                                            <img class="lazyload"
                                                data-src="<%= variant.images && variant.images[0] ? variant.images[0] : product.images[0] %>"
                                                src="<%= variant.images && variant.images[0] ? variant.images[0] : product.images[0] %>"
                                                alt="<%= product.name %> - <%= variant.color %>">
                                        </li>
                                        <% }); %>
                                    </ul>
                                    <% } %>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                        <% }); %>
                    <% } else { %>
                        <div class="swiper-slide">
                            <div class="col-12 text-center p-5">
                                <h4>No similar products found</h4>
                                
                            </div>
                        </div>
                    <% } %>
                </div>
            </div>
            <div class="nav-sw nav-next-slider nav-next-product box-icon w_46 round">
                <span class="icon icon-arrow-left"></span>
            </div>
            <div class="nav-sw nav-prev-slider nav-prev-product box-icon w_46 round">
                <span class="icon icon-arrow-right"></span>
            </div>
            <div class="sw-dots style-2 sw-pagination-product justify-content-center"></div>
        </div>
    </div>
</section>

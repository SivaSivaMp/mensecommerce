<%-include("../partials/user/header")%>
<style>
/* ---------------------------
   General Card Styling
---------------------------- */
.profile-card {
  background: #ffffff;
  border-radius: 14px;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
  padding: 35px;
  margin-bottom: 30px;
  transition: all 0.3s ease;
}

.profile-card:hover {
  box-shadow: 0 6px 25px rgba(0, 0, 0, 0.08);
}

/* ---------------------------
   Form Input Styling
---------------------------- */
.form-control {
  padding: 12px 14px;
  border-radius: 10px;
  border: 1px solid #dfe3e8;
  font-size: 15px;
  color: #333;
  background-color: #fafafa;
  transition: all 0.2s ease;
}

.form-control::placeholder {
  color: #adb5bd;
}

.form-control:focus {
  background-color: #fff;
  border-color: #088178;
  box-shadow: 0 0 0 0.2rem rgba(8, 129, 120, 0.15);
  outline: none;
}

/* ---------------------------
   Section Headings
---------------------------- */
.profile-card h6 {
  font-size: 1rem;
  font-weight: 600;
  color: #121313;
  margin-top: 10px;
  margin-bottom: 10px;
  letter-spacing: 0.3px;
}

/* ---------------------------
   Radio Buttons (Home/Work/Other)
---------------------------- */
input[type="radio"] {
  accent-color: #088178;
  margin-right: 6px;
  cursor: pointer;
}

label span {
  font-weight: 500;
  color: #444;
}

label span:hover {
  color: #088178;
}

/* ---------------------------
   Buttons
---------------------------- */
.save-btn {
  background-color: #088178;
  color: white;
  border: none;
  border-radius: 10px;
  padding: 12px 36px;
  font-size: 15px;
  font-weight: 600;
  letter-spacing: 0.5px;
  transition: all 0.3s ease;
}

.save-btn:hover {
  background-color: #066c65;
  transform: translateY(-1px);
}

.save-btn:disabled {
  background-color: #c2d3d0;
  cursor: not-allowed;
}

/* ---------------------------
   Alert Boxes
---------------------------- */
.alert {
  border-radius: 8px;
  font-size: 14px;
  padding: 12px 18px;
}

.alert-danger {
  background: #ffe5e5;
  color: #d32f2f;
  border: 1px solid #ffcdd2;
}

.alert-success {
  background: #e8f5e9;
  color: #2e7d32;
  border: 1px solid #c8e6c9;
}

/* ---------------------------
   Address Form Layout
---------------------------- */
#add-address-form .row {
  row-gap: 18px;
}

#add-address-form input[type="text"],
#add-address-form input[type="tel"] {
  font-weight: 400;
}

/* ---------------------------
   Success Toast
---------------------------- */
#copySuccess {
  position: fixed;
  top: 25px;
  right: 25px;
  padding: 14px 25px;
  background-color: #088178;
  color: white;
  border-radius: 10px;
  display: none;
  z-index: 1000;
  animation: fadeInOut 2s ease-in-out;
}

@keyframes fadeInOut {
  0% { opacity: 0; transform: translateY(-15px); }
  15% { opacity: 1; transform: translateY(0); }
  85% { opacity: 1; transform: translateY(0); }
  100% { opacity: 0; transform: translateY(-15px); }
}
</style>

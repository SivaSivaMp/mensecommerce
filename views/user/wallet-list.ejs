<%- include("../partials/user/header") %>
<style>
  .swal2-wallet-popup {
  max-width: 720px !important; /* match width option, override defaults */
  padding: 28px 30px !important;
  border-radius: 8px !important;
}

/* Make the input full width, taller and visually consistent */
.swal2-wallet-popup .swal2-input {
  width: 100% !important;
  box-sizing: border-box;
  height: 48px !important;
  padding: 10px 14px !important;
  font-size: 16px !important;
  border-radius: 6px !important;
  border: 1px solid #dfe3e8 !important;
  background: #fff !important;
  color: #222 !important;
  margin: 8px 0 12px !important;
}

/* Remove browser number spinner if any (defensive) */
.swal2-wallet-popup .swal2-input[type=number]::-webkit-outer-spin-button,
.swal2-wallet-popup .swal2-input[type=number]::-webkit-inner-spin-button {
  -webkit-appearance: none;
  margin: 0;
}
.swal2-wallet-popup .swal2-input[type=number] {
  -moz-appearance: textfield;
}

/* Adjust button area spacing if needed */
.swal2-wallet-popup .swal2-actions {
  margin-top: 12px !important;
}

/* Optional: keep mobile responsive */
@media (max-width: 640px) {
  .swal2-wallet-popup {
    width: calc(100% - 40px) !important;
    max-width: none !important;
    padding: 20px !important;
  }
  .swal2-wallet-popup .swal2-input {
    height: 44px !important;
    font-size: 15px !important;
  }
}
</style>

<div class="tf-breadcrumb">
  <div class="container">
    <div class="tf-breadcrumb-wrap d-flex justify-content-between flex-wrap align-items-center">
      <div class="tf-breadcrumb-list">
        <a href="/" class="text">Home</a>
        <i class="icon icon-arrow-right"></i>
        <span class="text">My Wallet</span>
      </div>
    </div>
  </div>
</div>

<section class="flat-spacing-11">
  <div class="container">
    <div class="row">
      <!-- Sidebar -->
<div class="col-lg-3">
                        <ul class="my-account-nav">
                            <li><a href="/profile" class="my-account-nav-item ">My Profile</a></li>                            
                            <li><a href="/profile/orders" class="my-account-nav-item">Orders</a></li>
                            <li><a href="/profile/address" class="my-account-nav-item">Addresses</a></li>
                            <li><span class="my-account-nav-item active">My Wallet</span></li>
                            <li><a href="/wishlist" class="my-account-nav-item">Wishlist</a></li>
                            <li><a href="/logout" class="my-account-nav-item">Logout</a></li>
                        </ul>
                    </div>

      <!-- Wallet Section -->
      <div class="col-lg-9">
        <div class="my-account-content account-order">

          <!-- Search + Filter + Add Money -->
          <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
            <!-- Left Side: Search + Filter -->
            <form method="GET" action="/profile/wallet" class="d-flex flex-wrap align-items-center gap-2">
              <!-- Search -->
              <div class="input-group input-group-sm" style="max-width: 250px;">
                <input type="search" name="query" class="form-control" placeholder="Search by Transaction ID or Order ID" value="<%= query || '' %>">
                <button type="submit" class="input-group-text">
                  <i class="icofont-search"></i>
                </button>
                <% if (query) { %>
                  <a href="/profile/wallet" class="input-group-text bg-danger text-white">
                    <i class="icofont-close"></i>
                  </a>
                <% } %>
              </div>

              <!-- Transaction Type Filter -->
              <select name="type" class="form-select form-select-sm" style="max-width:160px;">
                <option value="">All Types</option>
                <option value="credit" <%= type === 'credit' ? 'selected' : '' %>>Credit</option>
                <option value="debit" <%= type === 'debit' ? 'selected' : '' %>>Debit</option>
              </select>

              <button type="submit" class="btn btn-sm btn-primary">Apply</button>
              <a href="/profile/wallet" class="btn btn-sm btn-secondary">Reset</a>
            </form>
            <h3>Total balance: <%=Math.round(balance)%> </h3>
            <!-- Right Side: Add Money Button -->
            <a href="#" id="addMoneyBtn" class="tf-btn btn-fill animate-hover-btn radius-3">
              <span>Add Money</span>
            </a>
          </div>

          <!-- Wallet Table -->
          <div class="wrap-account-order">
            <table class="table table-striped align-middle">
              <thead>
                <tr>
                  <th class="fw-6">Transaction Id</th>
                  <th class="fw-6">Date</th>
                  <th class="fw-6">Description</th>
                  <th class="fw-6">Order Id</th>
                  <th class="fw-6">Transaction Type</th>
                  <th class="fw-6">Amount</th>
                </tr>
              </thead>
              <tbody>
                <% if (transactions && transactions.length > 0) { %>
                  <% transactions.forEach(txn => { %>
                    <tr>
                      <td><%= txn.transactionId %></td>
                      <td><%= new Date(txn.createdAt).toLocaleDateString() %></td>
                      <td><%= txn.description || '-' %></td>
                      <td><%= txn.userOrderId ? txn.userOrderId : '-' %></td>
                      <td>
                        <span class="badge <%= txn.type === 'credit' ? 'bg-success' : 'bg-danger' %> text-capitalize">
                          <%= txn.type %>
                        </span>
                      </td>
                      <td>₹<%= txn.amount.toFixed(2) %></td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td colspan="6" class="text-center text-muted py-4">
                      No transactions found.
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>

          <!-- Pagination (Optional) -->
          <% if (pagination && pagination.totalPages > 1) { %>
            <ul class="tf-pagination-wrap tf-pagination-list mt-4">
              <% if (pagination.hasPrev) { %>
                <li><a href="?page=<%= pagination.prevPage %>" class="pagination-link animate-hover-btn"><span class="icon icon-arrow-left"></span></a></li>
              <% } %>
              <% for (let i = 1; i <= pagination.totalPages; i++) { %>
                <li class="<%= i === pagination.currentPage ? 'active' : '' %>">
                  <a href="?page=<%= i %>" class="pagination-link"><%= i %></a>
                </li>
              <% } %>
              <% if (pagination.hasNext) { %>
                <li><a href="?page=<%= pagination.nextPage %>" class="pagination-link animate-hover-btn"><span class="icon icon-arrow-right"></span></a></li>
              <% } %>
            </ul>
          <% } %>

        </div>
      </div>
    </div>
  </div>
</section>

<%- include("../partials/user/footer") %>
<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>

<script>
  document.getElementById('addMoneyBtn').addEventListener('click', async function (e) {
    e.preventDefault();

    const { value: amount } = await Swal.fire({
        title: 'Add Money',
        input: 'text', // keep text for consistent styling
        inputLabel: 'Enter amount (in ₹)',
        inputPlaceholder: 'e.g. 500',
        inputAttributes: {
          inputmode: 'numeric',
          pattern: '[0-9]*',
          maxlength: 8
        },
        showCancelButton: true,
        confirmButtonText: 'Add Money',
        width: 720, // <-- increase modal width (px) to fit your layout
        customClass: {
          popup: 'swal2-wallet-popup' // custom class for additional CSS hooks
        },
        preConfirm: (value) => {
          if (!value || isNaN(value) || Number(value) <= 0) {
            Swal.showValidationMessage("Please enter a valid positive amount");
            return false;
          }
          return Number(value);
        }
      });

   

    try {
      // 1️⃣ Create Razorpay order
      const { data } = await axios.post('/wallet/create-order', { amount });

      // 2️⃣ Razorpay popup
      const options = {
        key: data.key_id,
        amount: data.amount,
        currency: 'INR',
        name: 'Mens Ecommerce',
        description: 'Add money to wallet',
        order_id: data.order_id,
        handler: async function (response) {
          const verify = await axios.post('/wallet/verify-payment', {
            ...response,
            amount,
          });
          if (verify.data.success) {
            Swal.fire('Success!', 'Money added successfully.', 'success').then(() => {
              window.location.reload();
            });
          } else {
            Swal.fire('Error', verify.data.message, 'error');
          }
        },
      };
      new Razorpay(options).open();
    } catch (err) {
      Swal.fire('Error', err.response?.data?.message || err.message, 'error');
    }
  });
</script>


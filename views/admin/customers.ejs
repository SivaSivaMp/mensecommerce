<!doctype html>
<html class="no-js" lang="en" dir="ltr">

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=Edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>::ecomus:: Customers </title>
    <link rel="icon"  href="/images/logo/favicon.png" type="image/png">
    <!-- plugin css file  -->
    <link rel="stylesheet" href="/assets/plugin/datatables/responsive.dataTables.min.css">
    <link rel="stylesheet" href="/assets/plugin/datatables/dataTables.bootstrap5.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
    <!-- project css file  -->
    <link rel="stylesheet" href="/assets/css/ebazar.style.min.css">
</head>
<body>
    <div id="ebazar-layout" class="theme-blue">
        <!-- sidebar -->
        <%- include('../partials/admin/admin-sidebar', { currentPage: 'customers' }) %>
        <!-- main body area -->
        <div class="main px-lg-4 px-md-4"> 
            <!-- Body: Header -->
            <%- include('../partials/admin/admin-header', { user: user || null }) %>
                <div class="order-0 col-lg-4 col-md-4 col-sm-12 col-12 mb-3 mb-md-0">
                    <form method="GET" action="/admin/users">
                        <div class="input-group flex-nowrap input-group-sm">
                            <input 
                                type="search" 
                                name="search"
                                class="form-control" 
                                placeholder="Search customers..." 
                                aria-label="search" 
                                aria-describedby="addon-wrapping" 
                                value="<%= search %>"
                            >
                            <button type="submit" class="input-group-text" id="addon-wrapping">
                                <i class="icofont-search"></i>
                            </button>
                            <% if (search && search.length > 0) { %>
                                <button type="button" class="input-group-text bg-danger text-white" id="clear-search">
                                    <i class="icofont-close"></i>
                                </button>
                            <% } %>
                        </div>
                    </form>
                </div>

            <!-- Body: Body -->       
                    <div class="body d-flex py-lg-3 py-md-2">
                        <div class="container-xxl">
                            <div class="row align-items-center">
                                <div class="border-0 mb-4">
                                    <div class="card-header py-3 no-bg bg-transparent d-flex align-items-center px-0 justify-content-between border-bottom flex-wrap">
                                        <h3 class="fw-bold mb-0">Customers Information</h3>                              
                                    </div>
                                </div>
                            </div> <!-- Row end  -->
                            <div class="row clearfix g-3">
                                <div class="col-sm-12">
                                    <div class="card mb-3">
                                        <div class="card-body">
                                            <table id="myProjectTable" class="table table-hover align-middle mb-0" style="width:100%">
                                                <small>user count :<%=currentCount%></small>
                                                <thead>
                                                    <tr>
                                                        <th>Id</th>
                                                        <th>Customers</th>                                                 
                                                        <th>Mail</th>
                                                        <th>Phone</th> 
                                                        <th>status</th>
                                                        <th>Actions</th>  
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <% data.forEach(function(user,index) { %>
                                                        <tr>
                                                            <td><%=index+1%></td>
                                                            <td><%= user.name %></td>
                                                            <td><%= user.email %></td>
                                                            <td><%= user.phone %></td>
                                                            <td><% if(user.isListed){%>
                                                                <span class="badge bg-danger" style="width: 65px;">blocked</span>
                                                                <%}else{%>
                                                                <span class="badge bg-success" style="width: 65px;">unblocked</span>
                                                                <%}%>
                                                            </td>
                                                            <td><% if (user.isBlocked) { %>
                                                                    <button class="btn btn-success btn-sm customer-status-btn"data-id="<%= user._id %>"data-action="unblock"style="width: 80px;">
                                                                        Block
                                                                    </button>
                                                                <% } else { %>
                                                                    <button class="btn btn-danger btn-sm customer-status-btn"data-id="<%= user._id %>"data-action="block"style="width: 80px;">
                                                                        Unblock
                                                                    </button>
                                                                <% } %></td>
                                                            
                                                        </tr>
                                                        <% }) %>
                                                </tbody>
                                                        
                                            </table>
                                    
                                </div>
                                <nav aria-label="Page navigation">
                                        <ul class="pagination justify-content-end">
                                            <!-- Previous Button -->
                                            <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
                                            <a class="page-link" 
                                                href="?page=<%= currentPage - 1 %>&search=<%= search %>" 
                                                tabindex="-1">Previous</a>
                                            </li>
                                            <!-- Page Numbers -->
                                            <% for (let i = 1; i <= totalPages; i++) { %>
                                            <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                                                <a class="page-link" href="?page=<%= i %>&search=<%= search %>"><%= i %></a>
                                            </li>
                                            <% } %>

                                            <!-- Next Button -->
                                            <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
                                            <a class="page-link" 
                                                href="?page=<%= currentPage + 1 %>&search=<%= search %>">Next</a>
                                            </li>
                                        </ul>
                                    </nav>
                            </div>
                        </div>
                    </div>
                </div>
            </div>         
        </div> 
    </div>
    
    <!-- Jquery Core Js -->
    <script src="../assets/bundles/libscripts.bundle.js"></script>

    <!-- Plugin Js-->
    <script src="../assets/bundles/dataTables.bundle.js"></script>

    <!-- Jquery Page Js -->
    <script src="../js/template.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>

    <script>

    document.addEventListener('DOMContentLoaded', function() {
        const clearButton = document.getElementById('clear-search');
        if (clearButton) {
            clearButton.addEventListener('click', function() {
                window.location.href = '/admin/users';
            });
        }
    });
    </script>
<script>
  $(document).ready(function() {
    $('#myProjectTable').addClass('nowrap');
  });
</script>
 <script>
document.addEventListener("DOMContentLoaded", () => {
    document.querySelectorAll(".customer-status-btn").forEach(btn => {
        btn.addEventListener("click", async function () {

            const id = this.getAttribute("data-id");
            const action = this.getAttribute("data-action");

            const confirm = await Swal.fire({
                title: action === "unblock" ? "Unblock this customer?" : "Block this customer?",
                text: action === "unblock"
                    ? "This customer will be blocked."
                    : "This customer will be visible.",
                icon: "warning",
                showCancelButton: true,
                confirmButtonText: "Yes",
                cancelButtonText: "Cancel"
            });

            if (!confirm.isConfirmed) return;

            try {
                const url = `/admin/users/${id}/${action}`;

                await axios.put(url);

                Swal.fire({
                    icon: "success",
                    title: action === "unblock" ? "Unblock this customer?" : "Block this customer?",
                    timer: 1500,
                    showConfirmButton: false
                });

                setTimeout(() => location.reload(), 1200);

            } catch (err) {
                Swal.fire({
                    icon: "error",
                    title: "Error",
                    text: err.response?.data?.message || "Operation failed"
                });
            }

        });
    });
});
</script>

</body>
</html>
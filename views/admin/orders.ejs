<!doctype html>
<html class="no-js" lang="en" dir="ltr">

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=Edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>::ecomus:: Orders </title>
    <link rel="icon"  href="/images/logo/favicon.png" type="image/png">
    <!-- plugin css file  -->
    <link rel="stylesheet" href="/assets/plugin/datatables/responsive.dataTables.min.css">
    <link rel="stylesheet" href="/assets/plugin/datatables/dataTables.bootstrap5.min.css">
    
    <!-- project css file  -->
    <link rel="stylesheet" href="/assets/css/ebazar.style.min.css">
</head>
<body>
    <div id="ebazar-layout" class="theme-blue">
        <!-- sidebar -->
        <%- include('../partials/admin/admin-sidebar', { currentPage: 'orders' }) %>
        <!-- main body area -->
        <div class="main px-lg-4 px-md-4"> 
            <!-- Body: Header -->
            <%- include('../partials/admin/admin-header', { user: user || null }) %>
            
            

            <!-- Body: Body -->       
            <div class="body d-flex py-lg-3 py-md-2">
                <div class="container-xxl">
                    <div class="row align-items-center">
                        <div class="border-0 mb-4">
                            <div class="card-header py-3 no-bg bg-transparent d-flex align-items-center px-0 justify-content-between border-bottom flex-wrap">
                                <h3 class="fw-bold mb-0">Order Management</h3>
                            </div>
                        </div>
                        <div class="order-0 col-lg-12 col-md-12 col-sm-12 mb-3">
                        <form method="GET" action="/admin/orders" class="d-flex flex-wrap gap-2 align-items-center">

                            <!-- 🔍 Search -->
                            <div class="input-group input-group-sm" style="max-width: 250px;">
                            <input type="search" name="search" class="form-control"
                                placeholder="Search by Order ID or Name..." value="<%= searchQuery %>">
                            <button type="submit" class="input-group-text"><i class="icofont-search"></i></button>
                            <% if (searchQuery) { %>
                                <a href="/admin/orders" class="input-group-text bg-danger text-white"><i class="icofont-close"></i></a>
                            <% } %>
                            </div>

                            <!-- 🧾 Status -->
                            <select name="status" class="form-select form-select-sm" style="max-width:180px;">
                            <option value="">All Statuses</option>
                            <% ['Pending', 'Processing', 'Shipped', 'Out for Delivery', 'Delivered', 'Cancelled', 'Return Request', 'Return Approved', 'Return Rejected', 'Returned'].forEach(st => { %>
                                <option value="<%= st %>" <%= statusFilter === st ? 'selected' : '' %>><%= st %></option>
                            <% }); %>
                            </select>

                            <!-- 💳 Payment -->
                            <select name="paymentMethod" class="form-select form-select-sm" style="max-width:150px;">
                            <option value="">All Payments</option>
                            <option value="cod" <%= paymentFilter === 'cod' ? 'selected' : '' %>>COD</option>
                            <option value="online" <%= paymentFilter === 'online' ? 'selected' : '' %>>Online</option>
                            </select>

                                

                            <!-- Filter Button -->
                            <button type="submit" class="btn btn-sm btn-primary">Apply Filters</button>
                            <a href="/admin/orders" class="btn btn-sm btn-secondary">Reset</a>
                        </form>
                        </div>
                    </div> <!-- Row end  -->
                    <div class="row clearfix g-3">
                        <div class="col-sm-12">
                            <div class="card mb-3">
                                <div class="card-body">
                                    <small>Order count: <%= totalOrders %></small>
                                    <table id="myProjectTable" class="table table-hover align-middle mb-0" style="width:100%">
                                        <thead>
                                            <tr>
                                                <th>Order Id</th>
                                                <th>User Name</th>                                                 
                                                <th>Billing Date</th>
                                                <th>Total Amount</th>
                                                <th>Payment Method</th>
                                                <th>Status</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% if (orders.length > 0) { %>
                                                <% orders.forEach((order) => { %>
                                                    <tr>
                                                        <td>
                                                            <strong><%= order.orderIdshort %></strong>
                                                            <br>
                                                            <small class="text-muted"><%= order.itemCount %> item(s)</small>
                                                        </td>
                                                        <td>
                                                            <%= order.userName %>
                                                            <br>
                                                            <small class="text-muted"><%= order.userEmail %></small>
                                                        </td>
                                                        <td>
                                                            <%= new Date(order.billingDate).toLocaleDateString('en-US', { 
                                                                year: 'numeric', 
                                                                month: 'short', 
                                                                day: 'numeric' 
                                                            }) %>
                                                            <br>
                                                            
                                                        </td>
                                                        <td>
                                                            <strong>₹<%= order.totalAmount.toLocaleString('en-IN') %></strong>
                                                        </td>
                                                        <td>
                                                            <%= order.paymentMethod %>
                                                            <br>
                                                            <small class="text-muted"><%= order.paymentStatus %></small>
                                                        </td>
                                                        <td>
                                                            <span class="badge 
                                                                <%= order.status === 'Delivered' ? 'bg-success' : '' %>
                                                                <%= order.status === 'Cancelled' ? 'bg-danger' : '' %>
                                                                <%= order.status === 'Pending' ? 'bg-warning' : '' %>
                                                                <%= order.status === 'Processing' ? 'bg-info' : '' %>
                                                                <%= order.status === 'Shipped' ? 'bg-primary' : '' %>
                                                                <%= order.status === 'Out for Delivery' ? 'bg-primary' : '' %>
                                                                <%= order.status === 'Return Request' ? 'bg-primary' : '' %>
                                                                <%= order.status === 'Return Approved' ? 'bg-info' : '' %>
                                                                <%= order.status === 'Return Rejected' ? 'bg-danger' : '' %>
                                                                <%= order.status === 'Returned' ? 'bg-info' : '' %>
                                                            ">
                                                                <%= order.status %>
                                                            </span>
                                                        </td>
                                                        <td>
                                                            <a href="/admin/orders/<%= order.orderId %>" class="btn btn-sm btn-primary">
                                                                <i class="icofont-eye"></i> View
                                                            </a>
                                                        </td>
                                                    </tr>
                                                <% }); %>
                                            <% } else { %>
                                                <tr>
                                                    <td colspan="7" class="text-center py-4">
                                                        <% if (searchQuery) { %>
                                                            <p class="text-muted mb-2">No orders found for "<%= searchQuery %>"</p>
                                                            <a href="/admin/orders" class="btn btn-sm btn-primary">View All Orders</a>
                                                        <% } else { %>
                                                            <p class="text-muted">No orders available</p>
                                                        <% } %>
                                                    </td>
                                                </tr>
                                            <% } %>
                                        </tbody>
                                    </table>

                                    <!-- Pagination -->
                                    <% if (pagination.totalPages > 1) { %>
                                        <nav aria-label="Page navigation">
                                            <ul class="pagination justify-content-end mt-3">
                                                <!-- Previous Button -->
                                                <li class="page-item <%= !pagination.hasPrevPage ? 'disabled' : '' %>">
                                                    <a class="page-link" 
                                                       href="<%= pagination.hasPrevPage ? '/admin/orders?page=' + pagination.prevPage + (searchQuery ? '&search=' + encodeURIComponent(searchQuery) : '') : '#' %>" 
                                                       tabindex="-1">Previous</a>
                                                </li>
                                                
                                                <!-- Page Numbers -->
                                                <% pagination.pages.forEach((pageNum) => { %>
                                                    <li class="page-item <%= pageNum === pagination.currentPage ? 'active' : '' %>">
                                                        <a class="page-link" 
                                                           href="/admin/orders?page=<%= pageNum %><%= searchQuery ? '&search=' + encodeURIComponent(searchQuery) : '' %>">
                                                            <%= pageNum %>
                                                        </a>
                                                    </li>
                                                <% }); %>

                                                <!-- Next Button -->
                                                <li class="page-item <%= !pagination.hasNextPage ? 'disabled' : '' %>">
                                                    <a class="page-link" 
                                                       href="<%= pagination.hasNextPage ? '/admin/orders?page=' + pagination.nextPage + (searchQuery ? '&search=' + encodeURIComponent(searchQuery) : '') : '#' %>">Next</a>
                                                </li>
                                            </ul>
                                        </nav>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>         
        </div> 
    </div>
    
    <!-- Jquery Core Js -->
    <script src="/assets/bundles/libscripts.bundle.js"></script>

    <!-- Plugin Js-->
    <script src="/assets/bundles/dataTables.bundle.js"></script>

    <!-- Jquery Page Js -->
    <script src="/js/template.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const clearButton = document.getElementById('clear-search');
            if (clearButton) {
                clearButton.addEventListener('click', function() {
                    window.location.href = '/admin/orders';
                });
            }
        });
    </script>
    <script>
        // project data table
        $(document).ready(function() {
            $('#myProjectTable')
            .addClass('nowrap')
            .dataTable({
                responsive: true,
                paging: false,
                sort: true,
                searching: false,
                columnDefs: [
                    { targets: [-1, -3], className: 'dt-body-right' }
                ]
            });
        });
    </script>
</body>
</html>
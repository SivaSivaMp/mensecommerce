<script>
  $(document).ready(function () {
    
    let lastRange = { start: null, end: null, label: 'today' };

    function showToast(message, type = "info") {
      let bgColor;
      switch (type) {
        case "success": bgColor = "linear-gradient(to right, #00b09b, #96c93d)"; break;
        case "error": bgColor = "linear-gradient(to right, #ff5f6d, #ffc371)"; break;
        case "warning": bgColor = "linear-gradient(to right, #f7971e, #ffd200)"; break;
        default: bgColor = "linear-gradient(to right, #00b4db, #0083b0)";
      }

      Toastify({
        text: message,
        duration: 3000,
        gravity: "top",
        position: "right",
        backgroundColor: bgColor,
        stopOnFocus: true,
      }).showToast();
    }

    function fetchSummary(start, end, label = 'custom') {
      lastRange = { start, end, label }; 

      $.ajax({
        url: `/admin/dashboard-summary?startDate=${start}&endDate=${end}`,
        method: 'GET',
        success: function (data) {
          $('#totalCustomers').text(data.totalCustomers.toLocaleString());
          $('#totalOrders').text(data.totalOrders.toLocaleString());
          $('#totalOrderItem').text(data.totalOrderItemCount.toLocaleString());
          $('#totalDiscount').text(`₹${data.totalDiscount.toLocaleString()}`);
          $('#avgSale').text(`₹${data.avgSale}`);
          $('#totalSales').text(`₹${data.totalSales.toLocaleString()}`);
          $('#totalCategories').text(data.totalCategories);
          $('#totalProducts').text(data.totalProducts);
          showToast(`Dashboard updated (${label.toUpperCase()})`, "success");
        },
        error: function (xhr) {
          console.error('Error fetching summary:', xhr);
          
          let errorMessage = "Failed to load dashboard data"; // default fallback
          
          if (xhr.responseJSON && xhr.responseJSON.message) {
            errorMessage = xhr.responseJSON.message; // backend message
          } else if (xhr.responseText) {
            // sometimes backend sends raw text
            errorMessage = xhr.responseText;
          }

          showToast(errorMessage, "error");
        }
      });
      
    }

    function getDateRange(type) {
      const now = new Date();
      let start, end = new Date();
      switch (type) {
        case 'today':
          start = new Date(now.setHours(0, 0, 0, 0));
          break;
        case 'week':
          start = new Date();
          start.setDate(end.getDate() - 7);
          break;
        case 'month':
          start = new Date();
          start.setDate(end.getDate() - 30);
          break;
        case 'year':
          start = new Date();
          start.setFullYear(end.getFullYear() - 1);
          break;
        default:
          start = new Date(now.setHours(0, 0, 0, 0));
      }
      fetchSummary(start.toISOString(), end.toISOString(), type);
    }

    // 🔹 Handle Tab Click (Today/Week/Month/Year)
    $(".nav-link.summary").click(function () {
      const period = $(this).text().trim().toLowerCase();
      getDateRange(period);
    });

   
    $("#applyFilter").click(function () {
      const start = $("#startDate").val();
      const end = $("#endDate").val();

      if (!start || !end) {
        showToast("Please select both start and end dates", "warning");
        return;
      }

      if (new Date(start) > new Date(end)) {
        showToast("Invalid date range! Start date cannot be after end date.", "error");
        return;
      }

      fetchSummary(start, end, 'custom');
    });

    // 🔹 Download Excel/PDF (Now uses lastRange)
      window.downloadReport = function (format) {
        if (!lastRange.start || !lastRange.end) {
          showToast("Please select a date range before downloading", "warning");
          return;
        }

        $.ajax({
          url: "/admin/reports/validate",
          method: "POST",
          data: {
            startDate: lastRange.start,
            endDate: lastRange.end
          },
          success: function () {
            const route = format === "excel"
              ? "/admin/reports/dashboard-excel"
              : "/admin/reports/dashboard-pdf";

            showToast(`Downloading ${format.toUpperCase()} report...`, "success");

            // Trigger download after validation passes
            window.location.href = `${route}?startDate=${lastRange.start}&endDate=${lastRange.end}`;
          },
          error: function (xhr) {
            let msg = "Unable to download report";

            if (xhr.responseJSON?.message) {
              msg = xhr.responseJSON.message;
            }

            showToast(msg, "error");

            if (xhr.status === 401) {
              setTimeout(() => {
                window.location.href = "/admin/login";
              }, 1200);
            }
          }
        });
      };

  
    getDateRange('today');
  });
</script>
<script>
$(document).ready(function () {

  let salesChart, donutChart;
  function showToast(message, type = "info") {
      let bgColor;
      switch (type) {
        case "success": bgColor = "linear-gradient(to right, #00b09b, #96c93d)"; break;
        case "error": bgColor = "linear-gradient(to right, #ff5f6d, #ffc371)"; break;
        case "warning": bgColor = "linear-gradient(to right, #f7971e, #ffd200)"; break;
        default: bgColor = "linear-gradient(to right, #00b4db, #0083b0)";
      }

      Toastify({
        text: message,
        duration: 3000,
        gravity: "top",
        position: "right",
        backgroundColor: bgColor,
        stopOnFocus: true,
      }).showToast();
    }
  function initSalesChart() {
    salesChart = new ApexCharts(
      document.querySelector("#apex-shoppingstatus"),
      {
        series: [
          { name: "Sales", data: [] },
          { name: "Order Items", data: [] }
        ],
        chart: { height: 270, type: "line", toolbar: { show: false } },
        stroke: { width: 2, curve: "smooth" },
        dataLabels: { enabled: false },
        xaxis: { categories: [] }
      }
    );
    salesChart.render();
  }

  function updateSalesChart(dates, sales, items) {
    salesChart.updateOptions({ xaxis: { categories: dates } });
    salesChart.updateSeries([
      { name: "Sales", data: sales },
      { name: "Order Items", data: items }
    ]);
  }

  function initDonutChart() {
    donutChart = new ApexCharts(
      document.querySelector("#apex-simple-donut"),
      {
        chart: { height: 250, type: "donut" },
        labels: [],
        series: []
      }
    );
    donutChart.render();
  }

  function updateDonutChart(counts) {
    donutChart.updateOptions({ labels: Object.keys(counts) });
    donutChart.updateSeries(Object.values(counts));
  }

 
  function loadCharts(start, end) {
    $.ajax({
      url: `/admin/dashboard-charts?startDate=${start}&endDate=${end}`,
      method: "GET",
      success: function (data) {
        updateSalesChart(data.dates, data.sales, data.orderItems);

        if (!data.statusCounts || Object.keys(data.statusCounts).length === 0) {
          updateDonutChart({ "No Data": 1 });
        } else {
          updateDonutChart(data.statusCounts);
        }
      }
    });
  }

 
  window.loadCharts = loadCharts;
  window.updateSalesChart = updateSalesChart;
  window.updateDonutChart = updateDonutChart;

  $(document).on("click", ".nav-link.chart", function () {
    const period = $(this).text().trim().toLowerCase();
    const now = new Date();
    let start, end = new Date();

    switch (period) {
      case "today":
        start = new Date(now.setHours(0,0,0,0)); break;
      case "week":
        start = new Date(); start.setDate(end.getDate() - 7); break;
      case "month":
        start = new Date(); start.setDate(end.getDate() - 30); break;
      case "year":
        start = new Date(); start.setFullYear(end.getFullYear() - 1); break;
    }

    loadCharts(start.toISOString(), end.toISOString());
  });


  $("#applyFilterChart").click(function () {
    const start = $("#startDateChart").val();
    const end = $("#endDateChart").val();
     if (!start || !end) {
        showToast("Please select both start and end dates", "warning");
        return;
      }

    loadCharts(start, end);
  });

  initSalesChart();
  initDonutChart();

  const today = new Date();
  const s = new Date(today.setHours(0,0,0,0)).toISOString();
  const e = new Date().toISOString();

  loadCharts(s, e);
});
</script>




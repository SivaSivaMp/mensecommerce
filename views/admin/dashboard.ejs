                  <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#summery-week">Week</a></li>
                  <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#summery-month">Month</a></li>
                  <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#summery-year">Year</a></li>
                </ul>

                <!-- Custom Date Filter -->
                <div class="date-filter d-flex align-items-center mt-2 mt-sm-0 w-sm-100">
                  <div class="input-group justify-content-between">
                    <input id="startDate" type="date" class="form-control">
                    <p class="mx-2 my-0">to</p>
                    <input id="endDate" type="date" class="form-control">
                    <button id="applyFilter" class="btn btn-primary" type="button">
                      <i class="icofont-filter fs-5"></i> Apply
                    </button>
                  </div>
                </div>
              </div>

              <!-- Download Buttons -->
              <div class="d-flex gap-2 mb-3">
                <button class="btn btn-success" onclick="downloadReport('excel')">
                  <i class="icofont-file-excel"></i> Excel
                </button>
                <button class="btn btn-danger" onclick="downloadReport('pdf')">
                  <i class="icofont-file-pdf"></i> PDF
                </button>
              </div>

              <!-- Summary Cards -->
              <div class="tab-content mt-1">
                <div class="tab-pane fade show active" id="summary">
                  <div class="row g-3 mb-3 row-deck">

                    <!-- Customers -->
                    <div class="col-xl-4 col-lg-4 col-md-4 col-sm-6">
                      <div class="card">
                        <div class="card-body py-3 d-flex flex-wrap align-items-center justify-content-between">
                          <div class="left-info">
                            <span class="text-muted">Customers</span>
                            <div><span id="totalCustomers" class="fs-6 fw-bold me-2">0</span></div>
                          </div>
                          <div class="right-icon"><i class="icofont-student-alt fs-3 color-light-orange"></i></div>
                        </div>
                      </div>
                    </div>

                    <!-- Orders -->
                    <div class="col-xl-4 col-lg-4 col-md-4 col-sm-6">
                      <div class="card">
                        <div class="card-body py-3 d-flex flex-wrap align-items-center justify-content-between">
                          <div class="left-info">
                            <span class="text-muted">Total Orders</span>
                            <div><span id="totalOrders" class="fs-6 fw-bold me-2">0</span></div>
                          </div>
                          <div class="right-icon"><i class="icofont-shopping-cart fs-3 color-lavender-purple"></i></div>
                        </div>
                      </div>
                    </div>
                    <!-- total items ordered -->
                    <div class="col-xl-4 col-lg-4 col-md-4 col-sm-6">
                      <div class="card">
                        <div class="card-body py-3 d-flex flex-wrap align-items-center justify-content-between">
                          <div class="left-info">
                            <span class="text-muted">Total Order Items</span>
                            <div><span id="totalOrderItem" class="fs-6 fw-bold me-2">0</span></div>
                          </div>
                          <div class="right-icon"><i class="icofont-gift fs-3 color-lightblue"></i></div>
                        </div>
                      </div>
                    </div>

                    <!-- Discounts -->
                    <div class="col-xl-4 col-lg-4 col-md-4 col-sm-6">
                      <div class="card">
                        <div class="card-body py-3 d-flex flex-wrap align-items-center justify-content-between">
                          <div class="left-info">
                            <span class="text-muted">Total Discount</span>
                            <div><span id="totalDiscount" class="fs-6 fw-bold me-2">$0</span></div>
                          </div>
                          <div class="right-icon"><i class="icofont-sale-discount fs-3 color-santa-fe"></i></div>
                        </div>
                      </div>
                    </div>

                    <!-- Avg Sale -->
                    <div class="col-xl-4 col-lg-4 col-md-4 col-sm-6">
                      <div class="card">
                        <div class="card-body py-3 d-flex flex-wrap align-items-center justify-content-between">
                          <div class="left-info">
                            <span class="text-muted">Avg Sale</span>
                            <div><span id="avgSale" class="fs-6 fw-bold me-2">$0</span></div>
                          </div>
                          <div class="right-icon"><i class="icofont-calculator-alt-2 fs-3 color-danger"></i></div>
                        </div>
                      </div>
                    </div>

                    <!-- Total Sale -->
                    <div class="col-xl-4 col-lg-4 col-md-4 col-sm-6">
                      <div class="card">
                        <div class="card-body py-3 d-flex flex-wrap align-items-center justify-content-between">
                          <div class="left-info">
                            <span class="text-muted">Total Sale</span>
                            <div><span id="totalSales" class="fs-6 fw-bold me-2">$0</span></div>
                          </div>
                          <div class="right-icon"><i class="icofont-calculator-alt-1 fs-3 color-lightblue"></i></div>
                        </div>
                      </div>
                    </div>

                    <!-- Total Categories -->
                    <div class="col-xl-4 col-lg-4 col-md-4 col-sm-6">
                      <div class="card">
                        <div class="card-body py-3 d-flex flex-wrap align-items-center justify-content-between">
                          <div class="left-info">
                            <span class="text-muted">Total Category</span>
                            <div><span id="totalCategories" class="fs-6 fw-bold me-2">0</span></div>
                          </div>
                          <div class="right-icon"><i class="icofont-chart-flow fs-3 color-light-success"></i></div>
                        </div>
                      </div>
                    </div>

                    <!-- Total Products -->
                    <div class="col-xl-4 col-lg-4 col-md-4 col-sm-6">
                      <div class="card">
                        <div class="card-body py-3 d-flex flex-wrap align-items-center justify-content-between">
                          <div class="left-info">
                            <span class="text-muted">Total Products</span>
                            <div><span id="totalProducts" class="fs-6 fw-bold me-2">0</span></div>
                          </div>
                          <div class="right-icon"><i class="icofont-bag fs-3 color-light-orange"></i></div>
                        </div>
                      </div>
                    </div>

                  </div>
                </div>
              </div>

            </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-xl-12">
                            <div class="card mb-3">
                                <div class="card-header py-3 d-flex justify-content-between align-items-center bg-transparent border-bottom-0">
                                    <h6 class="m-0 fw-bold">Sales Status</h6>
                                </div>
                                <div class="card-body">
                                    <div class="ac-line-transparent" id="apex-shoppingstatus"></div>
                                </div>
                            </div>
                            <div class="card">
                                <div class="card-header py-3 d-flex justify-content-between align-items-center bg-transparent border-bottom-0">
                                    <h6 class="m-0 fw-bold">Top Selling Product</h6>
                                </div>
                                <div class="card-body">
                                    <div id="topselling"></div>
                                </div>
                            </div>
                        </div>
                        
                    </div><!-- Row end  -->

                    <div class="row g-3 mb-3 row-deck">
                        
                        <div class="col-lg-8 col-md-12">
                            <div class="card">
                                <div class="card-header py-3 d-flex justify-content-between align-items-center bg-transparent border-bottom-0">
                                    <h6 class="m-0 fw-bold">Avg Expense Costs</h6>
                                </div>
                                <div class="card-body">
                                    <div class="h2 mb-0">$1105.5</div>
                                    <span class="text-muted small">Avg Expense Costs All Month</span>
                                    <div id="apex-expense"></div>  
                                </div>
                            </div>
                        </div>
                    </div><!-- Row end  -->   
                </div>
            </div> 
    </div>

    <!-- Jquery Core Js -->
    <script src="../assets/bundles/libscripts.bundle.js"></script>

    <!-- Plugin Js -->
    <script src="../assets/bundles/apexcharts.bundle.js"></script>
    <script src="../assets/bundles/dataTables.bundle.js"></script> 
    <script src="https://cdn.jsdelivr.net/npm/toastify-js"></script> 

    <!-- Jquery Page Js -->
    <script src="../js/template.js"></script>
    <script src="../js/page/index.js"></script>
    
    <script>
        $('#myDataTable')
        .addClass( 'nowrap')
        .dataTable( {
            responsive: true,
            columnDefs: [
                { targets: [-1, -3], className: 'dt-body-right' }
            ]
        });
    </script>
<script>
  $(document).ready(function () {
    // 🔹 Keep track of last-used date range
    let lastRange = { start: null, end: null, label: 'today' };

    function showToast(message, type = "info") {
      let bgColor;
      switch (type) {
        case "success": bgColor = "linear-gradient(to right, #00b09b, #96c93d)"; break;
        case "error": bgColor = "linear-gradient(to right, #ff5f6d, #ffc371)"; break;
        case "warning": bgColor = "linear-gradient(to right, #f7971e, #ffd200)"; break;
        default: bgColor = "linear-gradient(to right, #00b4db, #0083b0)";
      }

      Toastify({
        text: message,
        duration: 3000,
        gravity: "top",
        position: "right",
        backgroundColor: bgColor,
        stopOnFocus: true,
      }).showToast();
    }

    function fetchSummary(start, end, label = 'custom') {
      lastRange = { start, end, label }; // 🔹 Save the range for later use (for reports)

      $.ajax({
        url: `/admin/dashboard-summary?startDate=${start}&endDate=${end}`,
        method: 'GET',
        success: function (data) {
          $('#totalCustomers').text(data.totalCustomers.toLocaleString());
          $('#totalOrders').text(data.totalOrders.toLocaleString());
          $('#totalOrderItem').text(data.totalOrderItemCount.toLocaleString());
          $('#totalDiscount').text(`$${data.totalDiscount.toLocaleString()}`);
          $('#avgSale').text(`$${data.avgSale}`);
          $('#totalSales').text(`$${data.totalSales.toLocaleString()}`);
          $('#totalCategories').text(data.totalCategories);
          $('#totalProducts').text(data.totalProducts);
          showToast(`Dashboard updated (${label.toUpperCase()})`, "success");
        },
        error: function (err) {
          console.error('Error fetching summary:', err);
          showToast("Failed to load dashboard data", "error");
        }
      });
    }

    function getDateRange(type) {
      const now = new Date();
      let start, end = new Date();
      switch (type) {
        case 'today':
          start = new Date(now.setHours(0, 0, 0, 0));
          break;
        case 'week':
          start = new Date();
          start.setDate(end.getDate() - 7);
          break;
        case 'month':
          start = new Date();
          start.setDate(end.getDate() - 30);
          break;
        case 'year':
          start = new Date();
          start.setFullYear(end.getFullYear() - 1);
          break;
        default:
          start = new Date(now.setHours(0, 0, 0, 0));
      }
      fetchSummary(start.toISOString(), end.toISOString(), type);
    }

    // 🔹 Handle Tab Click (Today/Week/Month/Year)
    $(".nav-link").click(function () {
      const period = $(this).text().trim().toLowerCase();
      getDateRange(period);
    });

    // 🔹 Apply custom date filter
    $("#applyFilter").click(function () {
      const start = $("#startDate").val();
      const end = $("#endDate").val();

      if (!start || !end) {
        showToast("Please select both start and end dates", "warning");
        return;
      }

      if (new Date(start) > new Date(end)) {
        showToast("Invalid date range! Start date cannot be after end date.", "error");
        return;
      }

      fetchSummary(start, end, 'custom');
    });

    // 🔹 Download Excel/PDF (Now uses lastRange)
    window.downloadReport = function (format) {
      if (!lastRange.start || !lastRange.end) {
        showToast("Please select a date range before downloading", "warning");
        return;
      }

      const route = format === 'excel'
        ? '/admin/reports/dashboard-excel'
        : '/admin/reports/dashboard-pdf';

      showToast(`Generating ${format.toUpperCase()} report for ${lastRange.label}...`, "info");

      window.location.href = `${route}?startDate=${lastRange.start}&endDate=${lastRange.end}`;
    };

    // 🔹 Load "Today" by default on page load
    getDateRange('today');
  });
</script>

</body>


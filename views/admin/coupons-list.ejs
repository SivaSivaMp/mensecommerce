<!doctype html>
<html lang="en" dir="ltr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>::eBazar:: Coupons List</title>
  <link rel="stylesheet" href="/assets/plugin/datatables/responsive.dataTables.min.css">
  <link rel="stylesheet" href="/assets/plugin/datatables/dataTables.bootstrap5.min.css">
  <link rel="stylesheet" href="/assets/css/ebazar.style.min.css">
   <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
</head>

<body>
  <div id="ebazar-layout" class="theme-blue">
    <%- include('../partials/admin/admin-sidebar', { currentPage: 'coupons' }) %>
    <div class="main px-lg-4 px-md-4">
      <%- include('../partials/admin/admin-header', { user: user || null }) %>

      <div class="body d-flex py-lg-3 py-md-2">
        <div class="container-xxl">
          
                    <div class="row align-items-center">
                        <div class="border-0 mb-4">
                            <div class="card-header py-3 no-bg bg-transparent d-flex align-items-center px-0 justify-content-between border-bottom flex-wrap">
                                <h3 class="fw-bold mb-0">Coupon List</h3>
                                <div class="col-auto d-flex w-sm-100">
                                    <a href="/admin/coupons/add"class="btn btn-primary btn-set-task w-sm-100"><i class="icofont-plus-circle me-2 fs-6"></i>Add Coupon</a>
                                </div> 
                            </div>
                        </div>
                        <div class="order-0 col-lg-12 col-md-12 col-sm-12 mb-3">
                        <form method="GET" action="/admin/coupons" class="d-flex flex-wrap gap-2 align-items-center">

                            
                            <div class="input-group input-group-sm" style="max-width: 250px;">
                            <input type="search" name="search" class="form-control"
                                placeholder="Search by Coupon Code " value="<%= search %>">
                            <button type="submit" class="input-group-text"><i class="icofont-search"></i></button>
                            <% if (search) { %>
                                <a href="/admin/coupons" class="input-group-text bg-danger text-white"><i class="icofont-close"></i></a>
                            <% } %>
                            </div>
                        </form>
                        </div>
                    </div>

          <div class="row clearfix g-3">
            <div class="col-sm-12">
              <div class="card mb-3">
                <div class="card-body">
                  <table id="myProjectTable" class="table table-hover align-middle mb-0" style="width:100%">
                    <thead>
                      <tr>
                        <th>Coupon Code</th>
                        <th>Type</th>
                        <th>Discount</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th>Status</th>
                        <th>Actions</th>
                        <th>Edit</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% if (coupons && coupons.length > 0) { %>
                        <% coupons.forEach(coupon => { %>
                          <tr>
                            <td><strong><%= coupon.code %></strong></td>
                            <td><%= coupon.discountType === 'flat' ? 'Flat Amount' : 'Percentage' %></td>
                            <td>
                              <%= coupon.discountType === 'flat' 
                                  ? '₹' + coupon.discountValue 
                                  : coupon.discountValue + '%' %>
                            </td>
                            <td><%= coupon.startsAt.toLocaleDateString() %></td>
                            <td><%= coupon.expiresAt.toLocaleDateString() %></td>
                            <td>
                              <% if (!coupon.isActive) { %>
                                <span class="badge bg-danger">Inactive</span>
                              <% } else if (new Date() > new Date(coupon.expiresAt)) { %>
                                <span class="badge bg-warning text-dark" style="width: 60px;">Expired</span>
                              <% } else { %>
                                <span class="badge bg-success" style="width: 60px;">Active</span>
                              <% } %>
                            </td>
                            <td>
                            <% if (new Date(coupon.startsAt) > new Date()) { %>
                                <button class="btn btn-secondary btn-sm"  disabled>Upcoming</button>
                            <% } else if (new Date(coupon.expiresAt) < new Date()) { %>
                                <button class="btn btn-dark  btn-sm" style="width: 80px;" disabled>Expired</button>
                            <% } else if (coupon.isActive) { %>
                                <button class="btn btn-danger btn-sm toggle-btn" data-id="<%= coupon._id %>" data-action="deactivate" style="width: 80px;">Unlist</button>
                            <% } else { %>
                                <button class="btn btn-success btn-sm toggle-btn" data-id="<%= coupon._id %>" data-action="activate" style="width: 80px;">List</button>
                            <% } %>
                            </td>

                            <td>
                              <a href="/admin/coupons/edit/<%= coupon._id %>" class="btn btn-outline-secondary btn-sm">
                                <i class="icofont-edit text-success"></i>
                              </a>
                            </td>
                          </tr>
                        <% }) %>
                      <% } else { %>
                        <tr>
                          <td colspan="8" class="text-center text-muted py-4">
                            No coupons found.
                          </td>
                        </tr>
                      <% } %>
                    </tbody>
                  </table>
                </div>

                <!-- Pagination -->
                <% if (pagination.totalPages > 1) { %>
                    <nav aria-label="Page navigation">
                                            <ul class="pagination justify-content-end mt-3">
                                                <!-- Previous Button -->
                                                <li class="page-item <%= !pagination.hasPrevPage ? 'disabled' : '' %>">
                                                    <a class="page-link" 
                                                       href="<%= pagination.hasPrevPage ? '/admin/coupons?page=' + pagination.prevPage + (search ? '&search=' + encodeURIComponent(search) : '') : '#' %>" 
                                                       tabindex="-1">Previous</a>
                                                </li>
                                                
                                                <!-- Page Numbers -->
                                                <% pagination.pages.forEach((pageNum) => { %>
                                                    <li class="page-item <%= pageNum === pagination.currentPage ? 'active' : '' %>">
                                                        <a class="page-link" 
                                                           href="/admin/coupons=<%= pageNum %><%= search ? '&search=' + encodeURIComponent(search) : '' %>">
                                                            <%= pageNum %>
                                                        </a>
                                                    </li>
                                                <% }); %>

                                                <!-- Next Button -->
                                                <li class="page-item <%= !pagination.hasNextPage ? 'disabled' : '' %>">
                                                    <a class="page-link" 
                                                       href="<%= pagination.hasNextPage ? '/admin/coupons?page=' + pagination.nextPage + (search ? '&search=' + encodeURIComponent(search) : '') : '#' %>">Next</a>
                                                </li>
                                            </ul>
                                        </nav>
                                    <% } %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- JS -->
  <script src="/assets/bundles/libscripts.bundle.js"></script>
  <script src="/assets/bundles/dataTables.bundle.js"></script>
  <script src="/js/template.js"></script>
  <script>
    $(document).ready(function() {
      $('#myProjectTable').dataTable({
        responsive: true,
        paging: false,
        sort: true,
        searching: false,
      });
    });
  </script>
  <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
<script>
document.addEventListener('DOMContentLoaded', () => {
  const buttons = document.querySelectorAll('.toggle-btn');

  buttons.forEach(btn => {
    btn.addEventListener('click', async () => {
      const couponId = btn.getAttribute('data-id');
      const action = btn.getAttribute('data-action');

      try {
        // Send toggle request
        const response = await axios.get(`/admin/coupons/toggle/${couponId}?action=${action}`);
        const data = response.data;

        if (data.success) {
          showToast(data.message, 'success');
          setTimeout(() => window.location.reload(), 1000);
        } else {
          showToast(data.message || 'Operation failed', 'error');
        }
      } catch (err) {
        const message = err.response?.data?.message || 'Server error';
        showToast(message, 'error');
        console.error('Toggle error:', err);
      }
    });
  });

  function showToast(message, type) {
    let bg = 'linear-gradient(to right, #00b09b, #96c93d)';
    if (type === 'error') bg = 'linear-gradient(to right, #e74c3c, #c0392b)';
    if (type === 'warn') bg = 'linear-gradient(to right, #f39c12, #d35400)';
    Toastify({
      text: message,
      duration: 3500,
      close: true,
      gravity: 'top',
      position: 'right',
      style: { background: bg }
    }).showToast();
  }
});
</script>

</body>
</html>

<!doctype html>
<html class="no-js" lang="en" dir="ltr">

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=Edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>::ecomus:: Category </title>
    <link rel="icon"  href="/images/logo/favicon.png" type="image/png">
    <!-- plugin css file  -->
    <link rel="stylesheet" href="/assets/plugin/datatables/responsive.dataTables.min.css">
    <link rel="stylesheet" href="/assets/plugin/datatables/dataTables.bootstrap5.min.css">
    
    <!-- project css file  -->
    <link rel="stylesheet" href="/assets/css/ebazar.style.min.css">
</head>
<body>
    <div id="ebazar-layout" class="theme-blue">
        <!-- sidebar -->
        <%- include('../partials/admin/admin-sidebar', { currentPage: 'categories' }) %>
        <!-- main body area -->
        <div class="main px-lg-4 px-md-4"> 
            <!-- Body: Header -->
            <%- include('../partials/admin/admin-header', { user: user || null }) %>
                <div class="order-0 col-lg-4 col-md-4 col-sm-12 col-12 mb-3 mb-md-0">
                    <form method="GET" action="/admin/category">
                        <div class="input-group flex-nowrap input-group-sm">
                            <input 
                                type="search" 
                                name="search"
                                class="form-control" 
                                placeholder="Search categories..." 
                                aria-label="search" 
                                aria-describedby="addon-wrapping" 
                                value="<%= search %>"
                            >
                            <button type="submit" class="input-group-text" id="addon-wrapping">
                                <i class="icofont-search"></i>
                            </button>
                            <% if (search && search.length > 0) { %>
                                <button type="button" class="input-group-text bg-danger text-white" id="clear-search">
                                    <i class="icofont-close"></i>
                                </button>
                            <% } %>
                        </div>
                    </form>
                </div>

            <!-- Body: Body -->       
                    <div class="body d-flex py-lg-3 py-md-2">
                        <div class="container-xxl">
                            <div class="row align-items-center">
                                <div class="border-0 mb-4">
                                    <div class="card-header py-3 no-bg bg-transparent d-flex align-items-center px-0 justify-content-between border-bottom flex-wrap">
                                        <h3 class="fw-bold mb-0">Category Information</h3>
                                        <div class="col-auto d-flex w-sm-100">
                                        <a href="/admin/category/category-add"class="btn btn-primary btn-set-task w-sm-100"><i class="icofont-plus-circle me-2 fs-6"></i>Add Category</a>
    
  
                                       </div>                              
                                    </div>
                                </div>
                            </div> <!-- Row end  -->
                            <div class="row clearfix g-3">
                                <div class="col-sm-12">
                                    <div class="card mb-3">
                                        <div class="card-body">
                                            <table id="myProjectTable" class="table table-hover align-middle mb-0" style="width:100%">
                                                <small>categoty count :<%=currentCount%></small>
                                                <thead>
                                                    <tr>
                                                        <th>Id</th>
                                                        <th>Category Name</th>                                                 
                                                        <th>Description</th>
                                                        <th>Date</th>
                                                        <th>Offer</th>
                                                        <th>Update Offer</th>
                                                        <th>status</th>
                                                        <th>Actions</th>
                                                        <th>Edit</th>  
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <% data.forEach(function(category,index) { %>
                                                        <tr>
                                                            <td><%=index+1%></td>
                                                            <td><%= category.categoryName %></td>
                                                            <td><span class="d-inline-block text-truncate" style="max-width: 250px;" data-bs-toggle="tooltip" title="<%= category.description %>"> <%= category.description %> </span></td>
                                                            <td><%= new Date(category.createdAt).toLocaleDateString('en-US', { 
                                                            year: 'numeric', 
                                                            month: 'long', 
                                                            day: 'numeric' 
                                                                }) %></td>
                                                            <td><%=category.categoryOffer%>%</td> 
                                                            <td>
                                                            <% if (!category.isListed) { %>
                                                                <button class="btn btn-secondary btn-sm" style="width: 80px;"  disabled>N/A</button>
                                                            <% }  
                                                            else if (category.categoryOffer===0) { %>
                                                                <button class="btn btn-success btn-sm toggle-btn text-white" data-id="<%= category._id %>" data-action="add-offer" style="width: 80px;">Add</button>
                                                            <% } else if (category.categoryOffer>0) { %>
                                                                <button class="btn btn-danger btn-sm toggle-btn text-white" data-id="<%= category._id %>" data-action="remove-offer" style="width: 80px;" >Remove</button>
                                                            <% }%> 
                                                            </td>   
                                                            <td>
                                                                <% if(category.isListed){%>
                                                                <span class="badge bg-success" style="width: 60px;">listed</span>
                                                                <%}else{%>
                                                                <span class="badge bg-danger" style="width: 60px;">unlisted</span>
                                                                <%}%>
                                                            </td>                                                               

                                                            <td>
                                                                
                                                               <% if (category.isListed) { %>
                                                                    <button class="btn btn-danger btn-sm category-status-btn"data-id="<%= category._id %>"data-action="unlist"style="width: 80px;">
                                                                        Unlist
                                                                    </button>
                                                                <% } else { %>
                                                                    <button class="btn btn-success btn-sm category-status-btn"data-id="<%= category._id %>"data-action="list"style="width: 80px;">
                                                                        List
                                                                    </button>
                                                                <% } %>
                                                            </td>
                                                            <td>
                                                                <div class="btn-group" role="group" aria-label="Basic outlined example">
                                                                    <button type="button" class="btn btn-outline-secondary">
                                                                        <a   href="/admin/category/category-edit?id=<%= category._id %>"><i class="icofont-edit text-success"></i></a>
                                                                        
                                                                    </button>                                                        
                                                                     
                                                                </div>
                                                            </td>
                                                        </tr>
                                                        <% }) %>
                                                </tbody>
                                                        
                                            </table>
                                    <nav aria-label="Page navigation">
                                        <ul class="pagination justify-content-end">
                                            <!-- Previous Button -->
                                            <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
                                            <a class="page-link" 
                                                href="?page=<%= currentPage - 1 %>&search=<%= search %>" 
                                                tabindex="-1">Previous</a>
                                            </li>
                                            <!-- Page Numbers -->
                                            <% for (let i = 1; i <= totalPages; i++) { %>
                                            <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                                                <a class="page-link" href="?page=<%= i %>&search=<%= search %>"><%= i %></a>
                                            </li>
                                            <% } %>

                                            <!-- Next Button -->
                                            <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
                                            <a class="page-link" 
                                                href="?page=<%= currentPage + 1 %>&search=<%= search %>">Next</a>
                                            </li>
                                        </ul>
                                    </nav>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>         
        </div> 
    </div>
    
    <!-- Jquery Core Js -->
    <script src="../assets/bundles/libscripts.bundle.js"></script>

    <!-- Plugin Js-->
    <script src="../assets/bundles/dataTables.bundle.js"></script>

    <!-- Jquery Page Js -->
    <script src="../js/template.js"></script>
       
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script>

    document.addEventListener('DOMContentLoaded', function() {
        const clearButton = document.getElementById('clear-search');
        if (clearButton) {
            clearButton.addEventListener('click', function() {
                window.location.href = '/admin/category';
            });
        }
    });
    </script>
    <script>
        // project data table
        $(document).ready(function() {
            $('#myProjectTable')
            .addClass( 'compact' )
            .dataTable( {
                responsive: true,
                 paging: false,
                 sort:true,
                 searching:false,
                columnDefs: [
                    { targets: [-1, -3], className: 'dt-body-right' }
                ]
            });
            
        });
    </script>


<script>
document.addEventListener('DOMContentLoaded', function() {
  
    document.querySelectorAll('.toggle-btn').forEach(button => {
        button.addEventListener('click', async function() {
            const categoryId = this.getAttribute('data-id');
            const action = this.getAttribute('data-action');

            if (action === 'add-offer') {
                const { value: offerValue } = await Swal.fire({
                    title: 'Add Offer ',
                    input: 'number',
                    inputLabel: 'Offer (%)',
                    inputPlaceholder: 'Enter a value between 1 and 100',
                    inputAttributes: { min: 1, max: 100 },
                    showCancelButton: true,
                    confirmButtonText: 'Add Offer',
                });

                if (offerValue) {
                    try {
                        const response = await axios.post(`/admin/category/add-offer/${categoryId}`, {
                            offer: offerValue
                        });

                        Swal.fire({
                            icon: 'success',
                            title: 'Offer Added',
                            text: `Offer of ${offerValue}% successfully added.`,
                            timer: 1500,
                            showConfirmButton: false
                        });

                        
                        this.textContent = 'Remove Offer';
                        this.classList.remove('btn-success');
                        this.classList.add('btn-danger');
                        this.setAttribute('data-action', 'remove-offer');

                        
                        setTimeout(() => window.location.reload(), 1000);
                    } catch (error) {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: error.response?.data?.message || 'Something went wrong.'
                        });
                    }
                }
            }

            if (action === 'remove-offer') {
                const confirmRemove = await Swal.fire({
                    title: 'Are you sure?',
                    text: "Remove this offer?",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, remove it',
                    cancelButtonText: 'Cancel',
                });

                if (confirmRemove.isConfirmed) {
                    try {
                        await axios.post(`/admin/category/remove-offer/${categoryId}`);

                        Swal.fire({
                            icon: 'success',
                            title: 'Offer Removed',
                            timer: 1500,
                            showConfirmButton: false
                        });

                        
                        this.textContent = 'Add Offer';
                        this.classList.remove('btn-danger');
                        this.classList.add('btn-success');
                        this.setAttribute('data-action', 'add-offer');

                        
                        setTimeout(() => window.location.reload(), 1000);
                    } catch (error) {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: error.response?.data?.message || 'Something went wrong.'
                        });
                    }
                }
            }
        });
    });
});
</script>
<script>
document.addEventListener("DOMContentLoaded", () => {
    document.querySelectorAll(".category-status-btn").forEach(btn => {
        btn.addEventListener("click", async function () {

            const id = this.getAttribute("data-id");
            const action = this.getAttribute("data-action");

            const confirm = await Swal.fire({
                title: action === "unlist" ? "Unlist this category?" : "List this category?",
                text: action === "unlist"
                    ? "This category will be hidden from users."
                    : "This category will be visible to users.",
                icon: "warning",
                showCancelButton: true,
                confirmButtonText: "Yes",
                cancelButtonText: "Cancel"
            });

            if (!confirm.isConfirmed) return;

            try {
                const url = `/admin/category/${id}/${action}`;

                await axios.put(url);

                Swal.fire({
                    icon: "success",
                    title: action === "unlist" ? "Category Unlisted" : "Category Listed",
                    timer: 1500,
                    showConfirmButton: false
                });

                setTimeout(() => location.reload(), 1200);

            } catch (err) {
                Swal.fire({
                    icon: "error",
                    title: "Error",
                    text: err.response?.data?.message || "Operation failed"
                });
            }

        });
    });
});
</script>

</body>
</html>